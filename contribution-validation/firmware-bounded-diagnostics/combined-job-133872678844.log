2026-11-17T06:55:51.3906601Z REA_FIRMWARE_TESTED_FILE {"path": "src/domain/firmware/dfuse.ts", "sha256": "8a7f6412009cb87431582c3f786358fe7a4b858da0b08fe2550487ce15ff5f0c", "content": "import {\n  boundedList,\n  describeBoundedList,\n  type BoundedList,\n} from \"../boundedList.js\";\nimport { crc32 } from \"node:zlib\";\n\nimport type { DfuSeMetadata } from \"../artifactFormatMetadata.js\";\nimport { err, ok, type Result } from \"../result.js\";\nimport type { RegionDecodeFailure, RegionDecoder } from \"./regionDecoder.js\";\n\n/** \"DfuSe\", bVersion, DFUImageSize and bTargets (ST UM0391). */\nconst PREFIX_BYTES = 11;\n/** \"Target\", bAlternateSetting, bTargetNamed, szTargetName, dwTargetSize, dwNbElements. */\nconst TARGET_PREFIX_BYTES = 274;\nconst TARGET_NAME_OFFSET = 11;\nconst TARGET_NAME_BYTES = 255;\n/** dwElementAddress and dwElementSize. */\nconst ELEMENT_HEADER_BYTES = 8;\n/** bcdDevice, idProduct, idVendor, bcdDFU, \"UFD\", bLength and dwCRC (DFU 1.1). */\nexport const DFUSE_SUFFIX_BYTES = 16;\nconst DFUSE_VERSION = 1;\nconst DFU_SUFFIX_VERSION = 0x011a;\nconst ADDRESS_SPACE = 0x1_0000_0000;\n/** Elements named in one limitation before the rest are counted. */\nconst NAMED_ELEMENTS = 4;\nconst SIGNATURE = [0x44, 0x66, 0x75, 0x53, 0x65];\nconst TARGET_SIGNATURE = [0x54, 0x61, 0x72, 0x67, 0x65, 0x74];\nconst SUFFIX_SIGNATURE = [0x55, 0x46, 0x44];\n\n/**\n * Fixed whole-file ceiling, as for Intel HEX; configurable ceilings are\n * tracked in #6176. The decoder holds the file once and slices elements from it.\n */\nexport const DFUSE_MAX_FILE_BYTES = 128 * 1024 * 1024;\n/** Non-empty elements retained as inventory entries, as for UF2 regions. */\nexport const DFUSE_MAX_ELEMENTS = 65_536;\n\n/** One element: bytes the file declares for an address in one alternate setting. */\nexport interface DfuSeElement {\n  readonly targetIndex: number;\n  readonly alternateSetting: number;\n  /** szTargetName up to its first NUL, one character per byte; null when unnamed. */\n  readonly targetName: string | null;\n  readonly elementIndex: number;\n  readonly address: number;\n  /** The file offset of the element data. */\n  readonly dataOffset: number;\n  readonly bytes: Uint8Array;\n}\n\nexport interface DfuSeImage {\n  readonly metadata: DfuSeMetadata;\n  /** In file order; empty elements are counted in metadata but not listed. */\n  readonly elements: readonly DfuSeElement[];\n  readonly limitations: readonly string[];\n}\n\nconst readUint16 = (bytes: Uint8Array, offset: number): number =>\n  (bytes[offset] ?? 0) | ((bytes[offset + 1] ?? 0) << 8);\n\nconst readUint32 = (bytes: Uint8Array, offset: number): number =>\n  (readUint16(bytes, offset) | (readUint16(bytes, offset + 2) << 16)) >>> 0;\n\nconst startsWith = (\n  bytes: Uint8Array,\n  offset: number,\n  signature: readonly number[],\n): boolean => signature.every((byte, index) => bytes[offset + index] === byte);\n\nconst hex32 = (value: number): string =>\n  `0x${value.toString(16).padStart(8, \"0\")}`;\n\n/** Whether the leading bytes begin a DfuSe version 1 image. */\nexport const hasDfuSePrefix = (prefix: Uint8Array): boolean =>\n  startsWith(prefix, 0, SIGNATURE) && prefix[5] === DFUSE_VERSION;\n\n/** Whether the final 16 bytes are a DFU 1.1a suffix, as DfuSe requires. */\nconst hasDfuSeSuffix = (suffix: Uint8Array): boolean =>\n  suffix.length === DFUSE_SUFFIX_BYTES &&\n  readUint16(suffix, 6) === DFU_SUFFIX_VERSION &&\n  startsWith(suffix, 8, SUFFIX_SIGNATURE) &&\n  suffix[11] === DFUSE_SUFFIX_BYTES;\n\n/**\n * Recognize a file only by the DfuSe prefix and the DFU suffix together. The\n * suffix CRC is not part of recognition: a mismatch is an integrity fact.\n */\nexport const isDfuSeFile = (\n  prefix: Uint8Array,\n  suffix: Uint8Array,\n  fileBytes: number,\n): boolean =>\n  fileBytes >= PREFIX_BYTES + DFUSE_SUFFIX_BYTES &&\n  hasDfuSePrefix(prefix) &&\n  hasDfuSeSuffix(suffix);\n\n/** Start a decoder that holds at most the admitted file size. */\nexport const createDfuSeDecoder = (\n  fileBytes: number,\n): Result<RegionDecoder<DfuSeImage>, RegionDecodeFailure> =>\n  Number.isSafeInteger(fileBytes) &&\n  fileBytes >= 0 &&\n  fileBytes <= DFUSE_MAX_FILE_BYTES\n    ? ok(new RetainingDfuSeDecoder(fileBytes))\n    : err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: `file is ${String(fileBytes)} bytes, exceeding the fixed ${String(DFUSE_MAX_FILE_BYTES)}-byte (128 MiB) ceiling`,\n      });\n\n/** The DFU suffix CRC: CRC-32 without the final inversion, over every byte before dwCRC. */\nconst dfuCrc = (bytes: Uint8Array): number => ~crc32(bytes) >>> 0;\n\nconst formatFailure = (\n  offset: number,\n  detail: string,\n): RegionDecodeFailure => ({\n  kind: \"format\",\n  message: `byte offset ${String(offset)}: ${detail}`,\n});\n\n/** At most NAMED_ELEMENTS descriptions, then a count of the rest of `total`. */\nconst named = (items: readonly string[], total = items.length): string =>\n  describeBoundedList(\n    boundedList(items, NAMED_ELEMENTS, total - items.length),\n    \"; \",\n  );\n\nclass RetainingDfuSeDecoder implements RegionDecoder<DfuSeImage> {\n  readonly #bytes: Uint8Array;\n  #length = 0;\n\n  constructor(fileBytes: number) {\n    this.#bytes = new Uint8Array(fileBytes);\n  }\n\n  write(chunk: Uint8Array): Result<void, RegionDecodeFailure> {\n    if (this.#length + chunk.length > this.#bytes.length)\n      return err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: \"file grew beyond its admitted size while being read\",\n      });\n    this.#bytes.set(chunk, this.#length);\n    this.#length += chunk.length;\n    return ok(undefined);\n  }\n\n  finish(): Result<DfuSeImage, RegionDecodeFailure> {\n    return parseDfuSe(this.#bytes.subarray(0, this.#length));\n  }\n}\n\nconst parseDfuSe = (\n  bytes: Uint8Array,\n): Result<DfuSeImage, RegionDecodeFailure> => {\n  const suffixStart = bytes.length - DFUSE_SUFFIX_BYTES;\n  if (\n    bytes.length < PREFIX_BYTES + DFUSE_SUFFIX_BYTES ||\n    !hasDfuSePrefix(bytes) ||\n    !hasDfuSeSuffix(bytes.subarray(suffixStart))\n  )\n    return err(\n      formatFailure(\n        0,\n        \"the file does not begin with a DfuSe prefix and end with a DFU 1.1a suffix\",\n      ),\n    );\n  // UM0391 calls DFUImageSize the file length, which dfu-util's dfuse-pack.py\n  // writes since ee6b393d (2020-10-08). Earlier dfuse-pack.py and MicroPython's\n  // tools/dfu.py write the length before the suffix.\n  const imageSize = readUint32(bytes, 6);\n  const suffixCrc = readUint32(bytes, suffixStart + 12);\n  const computedCrc = dfuCrc(bytes.subarray(0, bytes.length - 4));\n  if (imageSize !== suffixStart && imageSize !== bytes.length)\n    return err(\n      formatFailure(\n        6,\n        `DFUImageSize declares ${String(imageSize)} bytes, but the DFU suffix begins at byte ${String(suffixStart)} and the file holds ${String(bytes.length)} bytes; the suffix CRC ${suffixCrc === computedCrc ? \"matches\" : \"does not match\"} the file`,\n      ),\n    );\n  const targetCount = bytes[10] ?? 0;\n  const walk = new TargetWalk(bytes, suffixStart);\n  let offset = PREFIX_BYTES;\n  for (let targetIndex = 0; targetIndex < targetCount; targetIndex += 1) {\n    const next = walk.target(targetIndex, offset);\n    if (!next.ok) return next;\n    offset = next.value;\n  }\n  if (offset !== suffixStart)\n    return err(\n      formatFailure(\n        offset,\n        `${String(targetCount)} target(s) end at byte ${String(offset)}, but the DFU suffix begins at byte ${String(suffixStart)}`,\n      ),\n    );\n  const { elements } = walk;\n  const overlaps = overlappingElements(elements);\n  const overlapCount = overlaps.items.length + overlaps.omitted;\n  return ok({\n    metadata: {\n      kind: \"dfuse\",\n      image_size: imageSize,\n      target_count: targetCount,\n      element_count: walk.elementCount,\n      empty_element_count: walk.emptyElements,\n      overlapping_element_count: overlapCount,\n      data_bytes: elements.reduce(\n        (sum, element) => sum + element.bytes.length,\n        0,\n      ),\n      device_version: readUint16(bytes, suffixStart),\n      product_id: readUint16(bytes, suffixStart + 2),\n      vendor_id: readUint16(bytes, suffixStart + 4),\n      suffix_crc: suffixCrc,\n      computed_crc: computedCrc,\n    },\n    elements,\n    limitations: [\n      ...(overlapCount === 0\n        ? []\n        : [\n            `${String(overlapCount)} DfuSe element(s) overlap an element earlier in address order within the same alternate setting; each stays a separate entry and no bytes were merged: ${describeBoundedList(overlaps, \"; \")}.`,\n          ]),\n      ...(walk.unlistedCount === 0\n        ? []\n        : [\n            `DfuSe declarations without bytes have no entry: ${named(walk.unlisted, walk.unlistedCount)}.`,\n          ]),\n    ],\n  });\n};\n\n/** Targets and elements in file order; every size is checked against its container. */\nclass TargetWalk {\n  readonly elements: DfuSeElement[] = [];\n  /**\n   * The first NAMED_ELEMENTS empty elements and element-less targets, which no\n   * entry can show. A file can hold millions of empty elements, so the rest\n   * are only counted in `unlistedCount`.\n   */\n  readonly unlisted: string[] = [];\n  unlistedCount = 0;\n  elementCount = 0;\n  emptyElements = 0;\n\n  constructor(\n    private readonly bytes: Uint8Array,\n    private readonly suffixStart: number,\n  ) {}\n\n  /** Parse one target at `offset`; the result is the offset after its elements. */\n  target(\n    targetIndex: number,\n    offset: number,\n  ): Result<number, RegionDecodeFailure> {\n    const { bytes } = this;\n    if (offset + TARGET_PREFIX_BYTES > this.suffixStart)\n      return err(\n        formatFailure(\n          offset,\n          `target ${String(targetIndex)} prefix needs ${String(TARGET_PREFIX_BYTES)} bytes, but the image ends at byte ${String(this.suffixStart)}`,\n        ),\n      );\n    if (!startsWith(bytes, offset, TARGET_SIGNATURE))\n      return err(\n        formatFailure(\n          offset,\n          `target ${String(targetIndex)} does not begin with the \"Target\" signature`,\n        ),\n      );\n    const targetSize = readUint32(bytes, offset + 266);\n    const declaredElements = readUint32(bytes, offset + 270);\n    const bodyStart = offset + TARGET_PREFIX_BYTES;\n    const bodyEnd = bodyStart + targetSize;\n    if (bodyEnd > this.suffixStart)\n      return err(\n        formatFailure(\n          offset + 266,\n          `target ${String(targetIndex)} declares ${String(targetSize)} bytes, but the image ends at byte ${String(this.suffixStart)}`,\n        ),\n      );\n    const target = {\n      targetIndex,\n      alternateSetting: bytes[offset + 6] ?? 0,\n      targetName:\n        readUint32(bytes, offset + 7) === 0\n          ? null\n          : latin1UntilNul(\n              bytes.subarray(\n                offset + TARGET_NAME_OFFSET,\n                offset + TARGET_NAME_OFFSET + TARGET_NAME_BYTES,\n              ),\n            ),\n    };\n    if (declaredElements === 0)\n      this.#unlisted(\n        () =>\n          `target ${String(targetIndex)} (alternate setting ${String(target.alternateSetting)}) declares no elements`,\n      );\n    let position = bodyStart;\n    for (let index = 0; index < declaredElements; index += 1) {\n      const next = this.#element(target, index, position, bodyEnd);\n      if (!next.ok) return next;\n      position = next.value;\n    }\n    return position === bodyEnd\n      ? ok(bodyEnd)\n      : err(\n          formatFailure(\n            position,\n            `target ${String(targetIndex)} declares ${String(targetSize)} bytes, but its ${String(declaredElements)} element(s) end ${String(bodyEnd - position)} bytes earlier`,\n          ),\n        );\n  }\n\n  #element(\n    target: Pick<\n      DfuSeElement,\n      \"targetIndex\" | \"alternateSetting\" | \"targetName\"\n    >,\n    elementIndex: number,\n    position: number,\n    bodyEnd: number,\n  ): Result<number, RegionDecodeFailure> {\n    const name = `target ${String(target.targetIndex)} element ${String(elementIndex)}`;\n    if (position + ELEMENT_HEADER_BYTES > bodyEnd)\n      return err(\n        formatFailure(\n          position,\n          `${name} header lies beyond the target's end at byte ${String(bodyEnd)}`,\n        ),\n      );\n    const address = readUint32(this.bytes, position);\n    const size = readUint32(this.bytes, position + 4);\n    const dataOffset = position + ELEMENT_HEADER_BYTES;\n    if (dataOffset + size > bodyEnd)\n      return err(\n        formatFailure(\n          position + 4,\n          `${name} declares ${String(size)} bytes, but its target ends at byte ${String(bodyEnd)}`,\n        ),\n      );\n    if (address + size > ADDRESS_SPACE)\n      return err(\n        formatFailure(\n          position,\n          `${name} at ${hex32(address)} with ${String(size)} bytes wraps past 0xffffffff`,\n        ),\n      );\n    if (size > 0 && this.elements.length >= DFUSE_MAX_ELEMENTS)\n      return err({\n        kind: \"limit\",\n        boundary: \"capacity\",\n        message: `byte offset ${String(position)}: the file holds more than ${String(DFUSE_MAX_ELEMENTS)} elements with bytes, the most retained as entries`,\n      });\n    this.elementCount += 1;\n    if (size === 0) {\n      this.emptyElements += 1;\n      this.#unlisted(\n        () =>\n          `${name} at ${hex32(address)} (alternate setting ${String(target.alternateSetting)}) holds no bytes`,\n      );\n    } else\n      this.elements.push({\n        ...target,\n        elementIndex,\n        address,\n        dataOffset,\n        bytes: this.bytes.subarray(dataOffset, dataOffset + size),\n      });\n    return ok(dataOffset + size);\n  }\n\n  /** Count a declaration without bytes; describe only the first few. */\n  #unlisted(describe: () => string): void {\n    this.unlistedCount += 1;\n    if (this.unlisted.length < NAMED_ELEMENTS) this.unlisted.push(describe());\n  }\n}\n\n/** szTargetName is a fixed field; bytes after the first NUL are padding. */\nconst latin1UntilNul = (field: Uint8Array): string => {\n  const end = field.indexOf(0);\n  return String.fromCharCode(\n    ...field.subarray(0, end < 0 ? field.length : end),\n  );\n};\n\nconst elementText = (element: DfuSeElement): string =>\n  `target ${String(element.targetIndex)} element ${String(element.elementIndex)} (${hex32(element.address)}-${hex32(element.address + element.bytes.length - 1)})`;\n\n/** Elements that overlap an earlier one in address order within one alternate setting. */\nconst overlappingElements = (\n  elements: readonly DfuSeElement[],\n): BoundedList<string> => {\n  const ordered = [...elements].sort(\n    (left, right) =>\n      left.alternateSetting - right.alternateSetting ||\n      left.address - right.address,\n  );\n  const overlaps: string[] = [];\n  let omitted = 0;\n  let reach: DfuSeElement | undefined;\n  for (const element of ordered) {\n    if (\n      reach !== undefined &&\n      reach.alternateSetting === element.alternateSetting &&\n      element.address < reach.address + reach.bytes.length\n    ) {\n      if (overlaps.length < NAMED_ELEMENTS)\n        overlaps.push(\n          `${elementText(element)} overlaps ${elementText(reach)} in alternate setting ${String(element.alternateSetting)}`,\n        );\n      else omitted += 1;\n    }\n    if (\n      reach === undefined ||\n      reach.alternateSetting !== element.alternateSetting ||\n      element.address + element.bytes.length >\n        reach.address + reach.bytes.length\n    )\n      reach = element;\n  }\n  return boundedList(overlaps, NAMED_ELEMENTS, omitted);\n};\n"}
2026-11-17T06:55:51.3982702Z REA_FIRMWARE_TESTED_FILE {"path": "src/domain/firmware/dfuse.test.ts", "sha256": "6ec846277071be8a3c691121a4ace2c6f3670db9136d985b93b1a3c517b9e0a9", "content": "import { createHash } from \"node:crypto\";\n\nimport { expect, it } from \"vitest\";\n\nimport {\n  DFUSE_MAX_FILE_BYTES,\n  createDfuSeDecoder,\n  isDfuSeFile,\n  type DfuSeImage,\n} from \"./dfuse.js\";\nimport { dfuseFile, type DfuSeFixture } from \"./dfuse.fixture.js\";\n\nconst decode = (bytes: Uint8Array, chunkSize = 64) => {\n  const decoder = createDfuSeDecoder(bytes.length);\n  if (!decoder.ok) throw new Error(decoder.error.message);\n  for (let offset = 0; offset < bytes.length; offset += chunkSize) {\n    const written = decoder.value.write(\n      bytes.subarray(offset, offset + chunkSize),\n    );\n    if (!written.ok) return written;\n  }\n  return decoder.value.finish();\n};\n\nconst image = (bytes: Uint8Array): DfuSeImage => {\n  const decoded = decode(bytes);\n  if (!decoded.ok) throw new Error(decoded.error.message);\n  return decoded.value;\n};\n\nconst recognized = (bytes: Uint8Array): boolean =>\n  isDfuSeFile(bytes.subarray(0, 4096), bytes.subarray(-16), bytes.length);\n\nconst elementFacts = ({ elements }: DfuSeImage) =>\n  elements.map(({ bytes, ...facts }) => ({ ...facts, length: bytes.length }));\n\n/** One 16-byte image at 0x08000000 in target \"ST...\", as the packers below write it. */\nconst DFUSE_PACK_EQUIVALENT: DfuSeFixture = {\n  targets: [\n    {\n      alternateSetting: 0,\n      name: \"ST...\",\n      elements: [{ address: 0x0800_0000, data: [...Array(16).keys()] }],\n    },\n  ],\n  deviceVersion: 0,\n};\n\nit(\"decodes files packed with and without the suffix in DFUImageSize\", () => {\n  // Oracle: build() and compute_crc() of dfu-util's dfuse-pack.py at f9a537c9,\n  // transcribed and run under Python 3. Since ee6b393d it writes DFUImageSize\n  // as PREFIX_SIZE + len(data) + SUFFIX_SIZE, the whole file.\n  const packed = dfuseFile({\n    ...DFUSE_PACK_EQUIVALENT,\n    imageSizeIncludesSuffix: true,\n  });\n  expect(createHash(\"sha256\").update(packed).digest(\"hex\")).toBe(\n    \"4d9f8c231291504484745f0b0586031c8f804d141e964cb33a9b82965f8a69d0\",\n  );\n  expect(image(packed).metadata).toMatchObject({\n    image_size: 325,\n    suffix_crc: 0x2c4c_4f44,\n    computed_crc: 0x2c4c_4f44,\n  });\n  const bytes = dfuseFile(DFUSE_PACK_EQUIVALENT);\n  // Oracle: build() and compute_crc() of MicroPython's tools/dfu.py at\n  // cb99ca98, transcribed and run under Python 3. It writes len(data) + 11,\n  // leaving the suffix out, as dfuse-pack.py did before ee6b393d.\n  expect(bytes.length).toBe(325);\n  expect(createHash(\"sha256\").update(bytes).digest(\"hex\")).toBe(\n    \"65ad96452f1f82cc8b44d30dfe94f268f4fd230a32b30a8826a639b269f7034d\",\n  );\n  const decoded = image(bytes);\n  expect(decoded.metadata).toEqual({\n    kind: \"dfuse\",\n    image_size: 309,\n    target_count: 1,\n    element_count: 1,\n    empty_element_count: 0,\n    overlapping_element_count: 0,\n    data_bytes: 16,\n    device_version: 0,\n    product_id: 0xdf11,\n    vendor_id: 0x0483,\n    suffix_crc: 0x7a37_11da,\n    computed_crc: 0x7a37_11da,\n  });\n  expect(elementFacts(decoded)).toEqual([\n    {\n      targetIndex: 0,\n      alternateSetting: 0,\n      targetName: \"ST...\",\n      elementIndex: 0,\n      address: 0x0800_0000,\n      dataOffset: 293,\n      length: 16,\n    },\n  ]);\n  expect(decoded.limitations).toEqual([]);\n});\n\nit(\"keeps each target's alternate setting and name on its elements\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          name: \"Internal Flash\",\n          elements: [\n            { address: 0x0800_0000, data: [1, 2, 3, 4] },\n            { address: 0x0800_4000, data: [5, 6] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          elements: [{ address: 0x1fff_c000, data: [0xaa, 0x55] }],\n        },\n        {\n          alternateSetting: 2,\n          name: Uint8Array.from([0x4f, 0xe9, 0, 0x58]),\n          elements: [{ address: 0x1fff_7800, data: [] }],\n        },\n      ],\n    }),\n  );\n  expect(\n    decoded.elements.map((element) => [\n      element.targetIndex,\n      element.alternateSetting,\n      element.targetName,\n      element.elementIndex,\n      element.address,\n      [...element.bytes],\n    ]),\n  ).toEqual([\n    [0, 0, \"Internal Flash\", 0, 0x0800_0000, [1, 2, 3, 4]],\n    [0, 0, \"Internal Flash\", 1, 0x0800_4000, [5, 6]],\n    [1, 1, null, 0, 0x1fff_c000, [0xaa, 0x55]],\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    target_count: 3,\n    element_count: 4,\n    empty_element_count: 1,\n    data_bytes: 8,\n  });\n  // A named target's field is read to its first NUL, one character per byte.\n  const named = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 3,\n          name: Uint8Array.from([0x4f, 0xe9, 0, 0x58]),\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    }),\n  );\n  expect(named.elements[0]?.targetName).toBe(\"O\u00e9\");\n});\n\nit(\"reports a suffix CRC mismatch as facts without refusing the file\", () => {\n  const decoded = image(dfuseFile({ ...DFUSE_PACK_EQUIVALENT, crc: 0 }));\n  expect(decoded.metadata).toMatchObject({\n    suffix_crc: 0,\n    computed_crc: 0x7a37_11da,\n  });\n  expect(decoded.elements).toHaveLength(1);\n});\n\nit(\"names overlapping elements within one alternate setting only\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [\n            { address: 0x0800_0000, data: [1, 2, 3, 4] },\n            { address: 0x0800_0002, data: [3, 4] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          elements: [{ address: 0x0800_0000, data: [9] }],\n        },\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0x0800_0003, data: [4, 5] }],\n        },\n      ],\n    }),\n  );\n  expect(decoded.metadata.overlapping_element_count).toBe(2);\n  expect(decoded.limitations).toHaveLength(1);\n  const limitation = decoded.limitations[0];\n  expect(limitation).toMatch(/overlap/iu);\n  expect(limitation).toMatch(/no bytes.*merged/iu);\n  expect(limitation).toMatch(/target 0 element 1[^;]*0x08000002-0x08000003/iu);\n  expect(limitation).toMatch(/target 0 element 0[^;]*0x08000000-0x08000003/iu);\n  expect(limitation).toMatch(/target 2 element 0[^;]*0x08000003-0x08000004/iu);\n});\n\nit(\"accepts boundary declarations beside the malformed ones\", () => {\n  // A valid file may hold no targets at all.\n  expect(image(dfuseFile({ targets: [] })).metadata).toMatchObject({\n    image_size: 11,\n    target_count: 0,\n    element_count: 0,\n  });\n  const name = Uint8Array.from({ length: 255 }, () => 0x41);\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 4,\n          // A name filling all 255 bytes has no NUL.\n          name,\n          elements: [\n            // An element may end exactly at the top of the address space.\n            { address: 0xffff_fffe, data: [1, 2] },\n            { address: 0x2000_0000, data: [] },\n          ],\n        },\n        { alternateSetting: 5, elements: [] },\n      ],\n    }),\n  );\n  expect(decoded.elements.map((element) => element.targetName)).toEqual([\n    \"A\".repeat(255),\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    target_count: 2,\n    element_count: 2,\n    empty_element_count: 1,\n  });\n  expect(decoded.limitations).toHaveLength(1);\n  const limitation = decoded.limitations[0];\n  expect(limitation).toMatch(/no entry/iu);\n  expect(limitation).toMatch(\n    /target 0 element 1[^;]*0x20000000[^;]*alternate setting 4/iu,\n  );\n  expect(limitation).toMatch(\n    /target 1[^;]*alternate setting 5[^;]*no elements/iu,\n  );\n});\n\nit(\"recognizes a file only by the DfuSe prefix together with the DFU suffix\", () => {\n  const bytes = dfuseFile(DFUSE_PACK_EQUIVALENT);\n  expect(recognized(bytes)).toBe(true);\n  const changed = (offset: number, value: number): Buffer => {\n    const copy = Buffer.from(bytes);\n    copy[offset] = value;\n    return copy;\n  };\n  expect(recognized(changed(5, 2))).toBe(false);\n  expect(recognized(changed(0, 0x64))).toBe(false);\n  expect(recognized(changed(bytes.length - 10, 0x00))).toBe(false);\n  expect(recognized(changed(bytes.length - 8, 0x58))).toBe(false);\n  expect(recognized(changed(bytes.length - 5, 15))).toBe(false);\n  expect(recognized(bytes.subarray(0, bytes.length - 1))).toBe(false);\n  // The CRC is checked after recognition, so a mismatch still recognizes.\n  expect(recognized(dfuseFile({ ...DFUSE_PACK_EQUIVALENT, crc: 1 }))).toBe(\n    true,\n  );\n});\n\nit.each([\n  [\n    \"a target without its signature\",\n    {\n      targets: [{ alternateSetting: 0, signature: \"Tarxet\", elements: [] }],\n    },\n    'byte offset 11: target 0 does not begin with the \"Target\" signature',\n  ],\n  [\n    \"an element larger than its target\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0, data: [1, 2], declaredSize: 3 }],\n        },\n      ],\n    },\n    \"byte offset 289: target 0 element 0 declares 3 bytes, but its target ends at byte 295\",\n  ],\n  [\n    \"a target larger than the image\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredSize: 100,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 277: target 0 declares 100 bytes, but the image ends at byte 294\",\n  ],\n  [\n    \"fewer elements than the target size\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredElements: 0,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 285: target 0 declares 9 bytes, but its 0 element(s) end 9 bytes earlier\",\n  ],\n  [\n    \"an image size that matches neither packer convention\",\n    { targets: [], imageSize: 12 },\n    \"byte offset 6: DFUImageSize declares 12 bytes, but the DFU suffix begins at byte 11 and the file holds 27 bytes; the suffix CRC matches the file\",\n  ],\n  [\n    \"bytes between the last target and the suffix\",\n    { targets: [], gap: Uint8Array.from([0]) },\n    \"byte offset 11: 0 target(s) end at byte 11, but the DFU suffix begins at byte 12\",\n  ],\n  [\n    \"more targets than the image holds\",\n    { targets: [], declaredTargets: 1 },\n    \"byte offset 11: target 0 prefix needs 274 bytes, but the image ends at byte 11\",\n  ],\n  [\n    \"more elements than the target holds\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredElements: 2,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 294: target 0 element 1 header lies beyond the target's end at byte 294\",\n  ],\n  [\n    \"an element that wraps the address space\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0xffff_ffff, data: [1, 2] }],\n        },\n      ],\n    },\n    \"byte offset 285: target 0 element 0 at 0xffffffff with 2 bytes wraps past 0xffffffff\",\n  ],\n] as const)(\"refuses %s with its byte offset\", (_name, fixture, message) => {\n  expect(decode(dfuseFile(fixture))).toEqual({\n    ok: false,\n    error: { kind: \"format\", message },\n  });\n});\n\nit(\"refuses files above the fixed ceiling and more elements than retained\", () => {\n  expect(createDfuSeDecoder(DFUSE_MAX_FILE_BYTES + 1)).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"file-size\" },\n  });\n  const elements = (count: number, data: readonly number[]) =>\n    Array.from({ length: count }, (_, index) => ({\n      address: index * 2,\n      data,\n    }));\n  const accepted = decode(\n    dfuseFile({\n      targets: [{ alternateSetting: 0, elements: elements(65_536, [1]) }],\n    }),\n    1 << 20,\n  );\n  if (!accepted.ok) throw new Error(accepted.error.message);\n  expect(accepted.value.elements).toHaveLength(65_536);\n  expect(\n    decode(\n      dfuseFile({\n        targets: [{ alternateSetting: 0, elements: elements(65_537, [1]) }],\n      }),\n      1 << 20,\n    ),\n  ).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"capacity\" },\n  });\n});\n\nit(\"counts empty elements past the entry cap and names only the first four\", () => {\n  // Empty elements have no entry, so they are not capped; 8 header bytes each\n  // let a file hold millions, and only a count and four descriptions are kept.\n  const empty = Array.from({ length: 65_537 }, (_, index) => ({\n    address: index * 2,\n    data: [],\n  }));\n  const decoded = decode(\n    dfuseFile({\n      targets: [\n        { alternateSetting: 0, elements: empty },\n        { alternateSetting: 1, elements: [] },\n      ],\n    }),\n    1 << 20,\n  );\n  if (!decoded.ok) throw new Error(decoded.error.message);\n  expect(decoded.value.elements).toEqual([]);\n  expect(decoded.value.metadata).toMatchObject({\n    element_count: 65_537,\n    empty_element_count: 65_537,\n    data_bytes: 0,\n  });\n  expect(decoded.value.limitations).toHaveLength(1);\n  const limitation = decoded.value.limitations[0];\n  expect(limitation).toMatch(/no entry/iu);\n  for (const [index, address] of [\n    [0, \"0x00000000\"],\n    [1, \"0x00000002\"],\n    [2, \"0x00000004\"],\n    [3, \"0x00000006\"],\n  ] as const)\n    expect(limitation).toMatch(\n      new RegExp(`element ${index}[^;]*${address}`, \"iu\"),\n    );\n  expect(limitation).toContain(\"65534 more\");\n});\n\nit(\"counts every overlap while naming only four in address order\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [\n            // File order is reversed; the earliest address is still the owner.\n            ...Array.from({ length: 9 }, (_, index) => ({\n              address: 0x0800_0000 + (8 - index),\n              data: [1, 2, 3, 4],\n            })),\n            { address: 0x0800_0020, data: [9] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          // A different alternate setting never adds an overlap.\n          elements: [{ address: 0x0800_0000, data: [9] }],\n        },\n      ],\n    }),\n  );\n  expect(decoded.elements).toHaveLength(11);\n  expect(decoded.metadata.overlapping_element_count).toBe(8);\n  expect(decoded.metadata.data_bytes).toBe(38);\n  expect(decoded.limitations).toEqual([\n    \"8 DfuSe element(s) overlap an element earlier in address order within the same alternate setting; each stays a separate entry and no bytes were merged: \" +\n      \"target 0 element 7 (0x08000001-0x08000004) overlaps target 0 element 8 (0x08000000-0x08000003) in alternate setting 0; \" +\n      \"target 0 element 6 (0x08000002-0x08000005) overlaps target 0 element 7 (0x08000001-0x08000004) in alternate setting 0; \" +\n      \"target 0 element 5 (0x08000003-0x08000006) overlaps target 0 element 6 (0x08000002-0x08000005) in alternate setting 0; \" +\n      \"target 0 element 4 (0x08000004-0x08000007) overlaps target 0 element 5 (0x08000003-0x08000006) in alternate setting 0; and 4 more.\",\n  ]);\n  expect(\n    decoded.elements.map((element) => ({\n      target: element.targetIndex,\n      index: element.elementIndex,\n      address: element.address,\n      bytes: [...element.bytes],\n    })),\n  ).toEqual([\n    ...Array.from({ length: 9 }, (_, index) => ({\n      target: 0,\n      index,\n      address: 0x0800_0000 + (8 - index),\n      bytes: [1, 2, 3, 4],\n    })),\n    { target: 0, index: 9, address: 0x0800_0020, bytes: [9] },\n    { target: 1, index: 0, address: 0x0800_0000, bytes: [9] },\n  ]);\n});\n"}
2026-11-17T06:55:51.4063993Z REA_FIRMWARE_TESTED_FILE {"path": "src/domain/firmware/uf2.ts", "sha256": "e99d4d18a9064f1b3b33f21c42ce51e2c0a6940f17c335c5b4b4957e4b46a233", "content": "import {\n  boundedList,\n  describeBoundedList,\n  type BoundedList,\n} from \"../boundedList.js\";\nimport type { Uf2Metadata } from \"../artifactFormatMetadata.js\";\nimport { err, ok, type Result } from \"../result.js\";\nimport { mergeArenaRuns, type RunConflict } from \"./addressRuns.js\";\nimport type { RegionDecodeFailure, RegionDecoder } from \"./regionDecoder.js\";\nimport { UF2_FAMILY_REGISTRY, uf2FamilyName } from \"./uf2Families.js\";\nimport { byteToHex } from \"../../kernel/byteToHex.js\";\n\n/** Every UF2 block is 512 bytes: a 32-byte header, 476 data bytes, an end magic. */\nexport const UF2_BLOCK_BYTES = 512;\nconst UF2_DATA_OFFSET = 32;\nconst UF2_DATA_BYTES = 476;\nconst UF2_MD5_BYTES = 24;\nconst UF2_MAGIC_START0 = 0x0a32_4655;\nconst UF2_MAGIC_START1 = 0x9e5d_5157;\nconst UF2_MAGIC_END = 0x0ab1_6f30;\nconst UF2_FLAG_NOT_MAIN_FLASH = 0x0000_0001;\nconst UF2_FLAG_FILE_CONTAINER = 0x0000_1000;\nconst UF2_FLAG_FAMILY_ID = 0x0000_2000;\nconst UF2_FLAG_MD5 = 0x0000_4000;\nconst UF2_FLAG_EXTENSION_TAGS = 0x0000_8000;\nconst ADDRESS_SPACE = 0x1_0000_0000;\n/** Numbering groups named in one limitation before the rest are counted. */\nconst NAMED_GROUPS = 4;\n\n/**\n * Fixed whole-file ceiling, as for Intel HEX; configurable ceilings are\n * tracked in #6176. Decoded bytes stay below 476/512 of it.\n */\nexport const UF2_MAX_FILE_BYTES = 128 * 1024 * 1024;\n/** Regions retained as inventory entries, as for Intel HEX record runs. */\nexport const UF2_MAX_REGIONS = 65_536;\n\n/** Decoded bytes for one family's address-contiguous range; `end` is inclusive. */\nexport interface Uf2Region {\n  /** The declared familyID, or null when the block did not set flag 0x2000. */\n  readonly familyId: number | null;\n  /** The registry short name REA knows for `familyId`, or null. */\n  readonly familyName: string | null;\n  readonly start: number;\n  readonly end: number;\n  readonly bytes: Uint8Array;\n  readonly blockCount: number;\n  /** Zero-based positions of the contributing blocks in the file. */\n  readonly firstFileBlock: number;\n  readonly lastFileBlock: number;\n}\n\nexport interface Uf2Image {\n  readonly metadata: Uf2Metadata;\n  /** Ordered by family, with undeclared families first, then by address. */\n  readonly regions: readonly Uf2Region[];\n  readonly complete: boolean;\n  readonly limitations: readonly string[];\n}\n\n/** Consecutive main-flash blocks of one family whose addresses continue each other. */\ninterface BlockRun {\n  readonly familyId: number | null;\n  readonly address: number;\n  readonly offset: number;\n  length: number;\n  blockCount: number;\n  readonly firstFileBlock: number;\n  lastFileBlock: number;\n}\n\n/**\n * Valid blocks sharing a familyID (or none) and a declared block count. A\n * number seen at several addresses belongs to several copies, as when esptool\n * numbers each merged file from 0; a repeat at one address is the same block.\n */\ninterface NumberingGroup {\n  readonly familyId: number | null;\n  readonly declared: number;\n  /** The first target address seen for each block number. */\n  readonly first: Map<number, number>;\n  /** Further distinct target addresses, only for numbers that have them. */\n  readonly further: Map<number, Set<number>>;\n  previous: number;\n}\n\n/** What block numbering establishes about completeness. */\ninterface NumberingFacts {\n  readonly missing: number;\n  readonly absent: BoundedList<string>;\n  readonly ambiguous: BoundedList<string>;\n}\n\nconst readUint32 = (bytes: Uint8Array, offset: number): number =>\n  ((bytes[offset] ?? 0) |\n    ((bytes[offset + 1] ?? 0) << 8) |\n    ((bytes[offset + 2] ?? 0) << 16) |\n    ((bytes[offset + 3] ?? 0) << 24)) >>>\n  0;\n\nconst hex32 = (value: number): string =>\n  `0x${value.toString(16).padStart(8, \"0\")}`;\n\nconst familyText = (familyId: number | null): string => {\n  if (familyId === null) return \"no familyID\";\n  const name = uf2FamilyName(familyId);\n  return name === null\n    ? `family ${hex32(familyId)}`\n    : `family ${hex32(familyId)} (${name})`;\n};\n\nconst groupText = (group: NumberingGroup): string =>\n  `${familyText(group.familyId)} with ${String(group.declared)} numbered blocks`;\n\n/** Recognize a file only by a complete first block with all three magic numbers. */\nexport const hasUf2Block = (prefix: Uint8Array): boolean =>\n  prefix.length >= UF2_BLOCK_BYTES &&\n  readUint32(prefix, 0) === UF2_MAGIC_START0 &&\n  readUint32(prefix, 4) === UF2_MAGIC_START1 &&\n  readUint32(prefix, UF2_BLOCK_BYTES - 4) === UF2_MAGIC_END;\n\n/** Start a block decoder whose arena is bounded by the admitted file size. */\nexport const createUf2Decoder = (\n  fileBytes: number,\n): Result<RegionDecoder<Uf2Image>, RegionDecodeFailure> =>\n  Number.isSafeInteger(fileBytes) &&\n  fileBytes >= 0 &&\n  fileBytes <= UF2_MAX_FILE_BYTES\n    ? ok(new StreamingUf2Decoder(fileBytes))\n    : err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: `file is ${String(fileBytes)} bytes, exceeding the fixed ${String(UF2_MAX_FILE_BYTES)}-byte (128 MiB) ceiling`,\n      });\n\n/** Absent numbers, and groups whose numbers appear at unequal address counts. */\nconst numberingFacts = (groups: Iterable<NumberingGroup>): NumberingFacts => {\n  let missing = 0;\n  const absent: string[] = [];\n  const ambiguous: string[] = [];\n  let absentOmitted = 0;\n  let ambiguousOmitted = 0;\n  for (const group of groups) {\n    const seen = group.first.size;\n    if (seen < group.declared) {\n      missing += group.declared - seen;\n      if (absent.length < NAMED_GROUPS)\n        absent.push(`${groupText(group)} has ${String(seen)} of them`);\n      else absentOmitted += 1;\n    }\n    // Every seen number holds one address unless another copy was seen.\n    let most = 1;\n    let fewest = group.further.size < seen ? 1 : Number.MAX_SAFE_INTEGER;\n    for (const further of group.further.values()) {\n      most = Math.max(most, further.size + 1);\n      fewest = Math.min(fewest, further.size + 1);\n    }\n    if (most !== fewest) {\n      if (ambiguous.length < NAMED_GROUPS)\n        ambiguous.push(\n          `${groupText(group)} has some numbers at ${String(fewest)} address(es) and others at ${String(most)}`,\n        );\n      else ambiguousOmitted += 1;\n    }\n  }\n  return {\n    missing,\n    absent: boundedList(absent, NAMED_GROUPS, absentOmitted),\n    ambiguous: boundedList(ambiguous, NAMED_GROUPS, ambiguousOmitted),\n  };\n};\n\nclass StreamingUf2Decoder implements RegionDecoder<Uf2Image> {\n  readonly #block = new Uint8Array(UF2_BLOCK_BYTES);\n  readonly #runs: BlockRun[] = [];\n  readonly #groups = new Map<string, NumberingGroup>();\n  readonly #families = new Set<number>();\n  #arena: Uint8Array;\n  #arenaWriteOffset = 0;\n  #blockLength = 0;\n  #blockCount = 0;\n  #invalid = 0;\n  #firstInvalid:\n    | { readonly block: number; readonly reason: string }\n    | undefined;\n  #flash = 0;\n  #notMainFlash = 0;\n  #notMainFlashBytes = 0;\n  #fileContainer = 0;\n  #md5 = 0;\n  #extensionTags = 0;\n  #repeated = 0;\n  #outOfOrder = 0;\n  #outOfRange = 0;\n\n  constructor(fileBytes: number) {\n    this.#arena = new Uint8Array(\n      Math.floor(fileBytes / UF2_BLOCK_BYTES) * UF2_DATA_BYTES,\n    );\n  }\n\n  write(chunk: Uint8Array): Result<void, RegionDecodeFailure> {\n    let from = 0;\n    while (from < chunk.length) {\n      const count = Math.min(\n        UF2_BLOCK_BYTES - this.#blockLength,\n        chunk.length - from,\n      );\n      this.#block.set(chunk.subarray(from, from + count), this.#blockLength);\n      this.#blockLength += count;\n      from += count;\n      if (this.#blockLength < UF2_BLOCK_BYTES) break;\n      this.#blockLength = 0;\n      const decoded = this.#decodeBlock(this.#block);\n      if (!decoded.ok) return decoded;\n    }\n    return ok(undefined);\n  }\n\n  finish(): Result<Uf2Image, RegionDecodeFailure> {\n    const merged = mergeRuns(this.#runs, this.#arena);\n    this.#arena = new Uint8Array(0);\n    if (!merged.ok) return merged;\n    const { regions, duplicateBytes } = merged.value;\n    if (regions.length > UF2_MAX_REGIONS)\n      return err({\n        kind: \"limit\",\n        boundary: \"capacity\",\n        message: `payloads form ${String(regions.length)} address-discontiguous regions, more than the ${String(UF2_MAX_REGIONS)} retained as entries`,\n      });\n    const numbering = numberingFacts(this.#groups.values());\n    const limitations = this.#limitations(numbering);\n    return ok({\n      metadata: this.#metadata(regions, duplicateBytes, numbering),\n      regions,\n      complete: limitations.unknown.length === 0,\n      limitations: [...limitations.unknown, ...limitations.known],\n    });\n  }\n\n  #decodeBlock(block: Uint8Array): Result<void, RegionDecodeFailure> {\n    const index = this.#blockCount;\n    this.#blockCount += 1;\n    const flags = readUint32(block, 8);\n    const address = readUint32(block, 12);\n    const size = readUint32(block, 16);\n    const fault =\n      readUint32(block, 0) !== UF2_MAGIC_START0 ||\n      readUint32(block, 4) !== UF2_MAGIC_START1\n        ? \"start magic numbers do not match\"\n        : readUint32(block, UF2_BLOCK_BYTES - 4) !== UF2_MAGIC_END\n          ? \"end magic number does not match\"\n          : size > UF2_DATA_BYTES\n            ? `payload size ${String(size)} exceeds the ${String(UF2_DATA_BYTES)}-byte data area`\n            : (flags & UF2_FLAG_MD5) !== 0 &&\n                size > UF2_DATA_BYTES - UF2_MD5_BYTES\n              ? \"payload overlaps the reserved MD5 checksum metadata\"\n              : address + size > ADDRESS_SPACE\n                ? `payload at ${hex32(address)} with ${String(size)} bytes wraps past 0xffffffff`\n                : undefined;\n    if (fault !== undefined) {\n      this.#invalid += 1;\n      this.#firstInvalid ??= { block: index, reason: fault };\n      return ok(undefined);\n    }\n    const familyId =\n      (flags & UF2_FLAG_FAMILY_ID) !== 0 ? readUint32(block, 28) : null;\n    if ((flags & UF2_FLAG_MD5) !== 0) this.#md5 += 1;\n    if ((flags & UF2_FLAG_EXTENSION_TAGS) !== 0) this.#extensionTags += 1;\n    this.#number(\n      familyId,\n      readUint32(block, 24),\n      readUint32(block, 20),\n      address,\n    );\n    // The file-container flag overrides not-main-flash: such blocks hold files.\n    if ((flags & UF2_FLAG_FILE_CONTAINER) !== 0) {\n      this.#fileContainer += 1;\n      return ok(undefined);\n    }\n    if ((flags & UF2_FLAG_NOT_MAIN_FLASH) !== 0) {\n      this.#notMainFlash += 1;\n      this.#notMainFlashBytes += size;\n      return ok(undefined);\n    }\n    this.#flash += 1;\n    if (familyId !== null) this.#families.add(familyId);\n    return this.#addData(\n      index,\n      familyId,\n      address,\n      block.subarray(UF2_DATA_OFFSET, UF2_DATA_OFFSET + size),\n    );\n  }\n\n  /** Numbering is per familyID and block count, as bootloaders ignore other families. */\n  #number(\n    familyId: number | null,\n    declared: number,\n    blockNo: number,\n    address: number,\n  ): void {\n    if (declared === 0 || blockNo >= declared) {\n      this.#outOfRange += 1;\n      return;\n    }\n    const key = `${familyId === null ? \"none\" : String(familyId)}:${String(declared)}`;\n    let group = this.#groups.get(key);\n    if (group === undefined) {\n      group = {\n        familyId,\n        declared,\n        first: new Map(),\n        further: new Map(),\n        previous: -1,\n      };\n      this.#groups.set(key, group);\n    }\n    const first = group.first.get(blockNo);\n    if (first === undefined) group.first.set(blockNo, address);\n    else {\n      this.#repeated += 1;\n      if (first !== address) {\n        let further = group.further.get(blockNo);\n        if (further === undefined) {\n          further = new Set();\n          group.further.set(blockNo, further);\n        }\n        further.add(address);\n      }\n    }\n    if (blockNo <= group.previous) this.#outOfOrder += 1;\n    group.previous = blockNo;\n  }\n\n  #addData(\n    block: number,\n    familyId: number | null,\n    address: number,\n    data: Uint8Array,\n  ): Result<void, RegionDecodeFailure> {\n    if (data.length === 0) return ok(undefined);\n    if (this.#arenaWriteOffset + data.length > this.#arena.length)\n      return err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: `block ${String(block)}: payload bytes exceed ${String(UF2_DATA_BYTES)} per complete block of the admitted file size`,\n      });\n    const run = this.#runs.at(-1);\n    if (\n      run !== undefined &&\n      run.familyId === familyId &&\n      run.address + run.length === address\n    ) {\n      run.length += data.length;\n      run.blockCount += 1;\n      run.lastFileBlock = block;\n    } else\n      this.#runs.push({\n        familyId,\n        address,\n        offset: this.#arenaWriteOffset,\n        length: data.length,\n        blockCount: 1,\n        firstFileBlock: block,\n        lastFileBlock: block,\n      });\n    this.#arena.set(data, this.#arenaWriteOffset);\n    this.#arenaWriteOffset += data.length;\n    return ok(undefined);\n  }\n\n  /** Limitations that leave coverage unknown, then facts that do not. */\n  #limitations(numbering: NumberingFacts): {\n    readonly unknown: string[];\n    readonly known: string[];\n  } {\n    const unknown: string[] = [];\n    const known: string[] = [];\n    if (this.#blockLength > 0)\n      unknown.push(\n        `UF2 file ends with ${String(this.#blockLength)} bytes after its last complete 512-byte block; the file may be truncated.`,\n      );\n    if (this.#firstInvalid !== undefined)\n      unknown.push(\n        `${String(this.#invalid)} UF2 block(s) are invalid and were excluded; the first is block ${String(this.#firstInvalid.block)} at byte offset ${String(this.#firstInvalid.block * UF2_BLOCK_BYTES)}: ${this.#firstInvalid.reason}.`,\n      );\n    if (numbering.missing > 0)\n      unknown.push(\n        `UF2 numbering declares ${String(numbering.missing)} block(s) that are absent: ${describeBoundedList(numbering.absent, \"; \")}.`,\n      );\n    if (numbering.ambiguous.items.length + numbering.ambiguous.omitted > 0)\n      unknown.push(\n        `UF2 numbering cannot show that every copy of a block sequence is complete: ${describeBoundedList(numbering.ambiguous, \"; \")}.`,\n      );\n    if (this.#outOfRange > 0)\n      unknown.push(\n        `${String(this.#outOfRange)} UF2 block(s) have a block number at or above their block count, so their numbering cannot establish completeness.`,\n      );\n    if (this.#fileContainer > 0)\n      unknown.push(\n        `${String(this.#fileContainer)} UF2 block(s) belong to file containers (flag 0x1000); their files were not reconstructed.`,\n      );\n    if (this.#notMainFlash > 0)\n      known.push(\n        `${String(this.#notMainFlash)} UF2 block(s) are flagged not main flash (flag 0x1); their ${String(this.#notMainFlashBytes)} payload bytes are in no region.`,\n      );\n    if (this.#md5 > 0 || this.#extensionTags > 0)\n      known.push(\n        `${String(this.#md5)} UF2 block(s) declare an MD5 flash region (flag 0x4000) and ${String(this.#extensionTags)} declare extension tags (flag 0x8000); both are counted, not decoded or verified.`,\n      );\n    return { unknown, known };\n  }\n\n  #metadata(\n    regions: readonly Uf2Region[],\n    duplicateBytes: number,\n    numbering: NumberingFacts,\n  ): Uf2Metadata {\n    return {\n      kind: \"uf2\",\n      block_count: this.#blockCount,\n      trailing_bytes: this.#blockLength,\n      invalid_block_count: this.#invalid,\n      flash_block_count: this.#flash,\n      not_main_flash_block_count: this.#notMainFlash,\n      file_container_block_count: this.#fileContainer,\n      md5_block_count: this.#md5,\n      extension_tag_block_count: this.#extensionTags,\n      family_count: this.#families.size,\n      family_name_registry: UF2_FAMILY_REGISTRY,\n      numbering_group_count: this.#groups.size,\n      missing_block_count: numbering.missing,\n      ambiguous_numbering_group_count:\n        numbering.ambiguous.items.length + numbering.ambiguous.omitted,\n      repeated_block_count: this.#repeated,\n      out_of_order_block_count: this.#outOfOrder,\n      block_number_out_of_range_count: this.#outOfRange,\n      region_count: regions.length,\n      data_bytes: regions.reduce((sum, region) => sum + region.bytes.length, 0),\n      duplicate_bytes: duplicateBytes,\n    };\n  }\n}\n\nconst blockSpan = (run: BlockRun): string =>\n  run.firstFileBlock === run.lastFileBlock\n    ? `block ${String(run.firstFileBlock)}`\n    : `blocks ${String(run.firstFileBlock)}-${String(run.lastFileBlock)}`;\n\n/** Merge each family's runs by address; overlaps must repeat the same bytes. */\nconst mergeRuns = (\n  runs: readonly BlockRun[],\n  arena: Uint8Array,\n): Result<\n  { readonly regions: Uf2Region[]; readonly duplicateBytes: number },\n  RegionDecodeFailure\n> => {\n  // Undeclared families sort first; other families never merge with them.\n  const merged = mergeArenaRuns(runs, arena, (run) => run.familyId ?? -1);\n  if (!merged.ok) return err(conflict(merged.error));\n  return ok({\n    regions: merged.value.ranges.map(({ start, bytes, runs: group }) => {\n      const familyId = group[0]?.familyId ?? null;\n      return {\n        familyId,\n        familyName: familyId === null ? null : uf2FamilyName(familyId),\n        start,\n        end: start + bytes.length - 1,\n        bytes,\n        blockCount: group.reduce((sum, run) => sum + run.blockCount, 0),\n        firstFileBlock: group.reduce(\n          (block, run) => Math.min(block, run.firstFileBlock),\n          Number.MAX_SAFE_INTEGER,\n        ),\n        lastFileBlock: group.reduce(\n          (block, run) => Math.max(block, run.lastFileBlock),\n          0,\n        ),\n      };\n    }),\n    duplicateBytes: merged.value.duplicateBytes,\n  });\n};\n\nconst conflict = ({\n  address,\n  writer,\n  run,\n  existing,\n  incoming,\n}: RunConflict<BlockRun>): RegionDecodeFailure => ({\n  kind: \"format\",\n  message: `${familyText(run.familyId)} address ${hex32(address)} is written with different values by ${blockSpan(writer)} (0x${byteToHex(existing)}) and ${blockSpan(run)} (0x${byteToHex(incoming)})`,\n});\n"}
2026-11-17T06:55:51.4156290Z REA_FIRMWARE_TESTED_FILE {"path": "src/domain/firmware/uf2.test.ts", "sha256": "889a14066337d04fbdb6860c13507a73d5cd5713487ede24b33840ca51dd8fbd", "content": "import { expect, it } from \"vitest\";\n\nimport {\n  createUf2Decoder,\n  hasUf2Block,\n  UF2_MAX_FILE_BYTES,\n  type Uf2Image,\n} from \"./uf2.js\";\nimport {\n  RP2040_FAMILY,\n  RP2350_ARM_S_FAMILY,\n  RP2XXX_ABSOLUTE_FAMILY,\n  UF2_FLAGS,\n  patternBytes,\n  uf2Block,\n  uf2File,\n  uf2Image,\n} from \"./uf2.fixture.js\";\n\nconst decode = (bytes: Uint8Array, chunkSize = bytes.length || 1) => {\n  const decoder = createUf2Decoder(bytes.length);\n  if (!decoder.ok) throw new Error(decoder.error.message);\n  for (let offset = 0; offset < bytes.length; offset += chunkSize) {\n    const written = decoder.value.write(\n      bytes.subarray(offset, offset + chunkSize),\n    );\n    if (!written.ok) return written;\n  }\n  return decoder.value.finish();\n};\n\nconst image = (bytes: Uint8Array, chunkSize?: number): Uf2Image => {\n  const decoded = decode(bytes, chunkSize);\n  if (!decoded.ok) throw new Error(decoded.error.message);\n  return decoded.value;\n};\n\nconst regionFacts = ({ regions }: Uf2Image) =>\n  regions.map(({ bytes, ...facts }) => ({ ...facts, length: bytes.length }));\n\nit(\"recognizes only a complete first block with all three magic numbers\", () => {\n  const block = uf2Block({\n    address: 0x1000_0000,\n    payload: [1],\n    blockNo: 0,\n    numBlocks: 1,\n  });\n  expect(hasUf2Block(block)).toBe(true);\n  expect(hasUf2Block(block.subarray(0, 511))).toBe(false);\n  for (const magics of [\n    [0x0a32_4656, 0x9e5d_5157, 0x0ab1_6f30],\n    [0x0a32_4655, 0x9e5d_5156, 0x0ab1_6f30],\n    [0x0a32_4655, 0x9e5d_5157, 0x0ab1_6f31],\n  ] as const)\n    expect(\n      hasUf2Block(\n        uf2Block({\n          address: 0,\n          payload: [1],\n          blockNo: 0,\n          numBlocks: 1,\n          magics,\n        }),\n      ),\n    ).toBe(false);\n});\n\nit(\"joins one family's numbered blocks into a region across chunk boundaries\", () => {\n  const bytes = patternBytes(1000);\n  const file = uf2File(uf2Image(RP2040_FAMILY, 0x1000_0000, bytes));\n  for (const chunkSize of [file.length, 512, 100, 7]) {\n    const decoded = image(file, chunkSize);\n    expect(decoded.complete).toBe(true);\n    expect(decoded.limitations).toEqual([]);\n    expect(regionFacts(decoded)).toEqual([\n      {\n        familyId: RP2040_FAMILY,\n        familyName: \"RP2040\",\n        start: 0x1000_0000,\n        end: 0x1000_03e7,\n        length: 1000,\n        blockCount: 4,\n        firstFileBlock: 0,\n        lastFileBlock: 3,\n      },\n    ]);\n    expect(Buffer.compare(decoded.regions[0]!.bytes, bytes)).toBe(0);\n  }\n  expect(image(file).metadata).toEqual({\n    kind: \"uf2\",\n    block_count: 4,\n    trailing_bytes: 0,\n    invalid_block_count: 0,\n    flash_block_count: 4,\n    not_main_flash_block_count: 0,\n    file_container_block_count: 0,\n    md5_block_count: 0,\n    extension_tag_block_count: 0,\n    family_count: 1,\n    family_name_registry: \"microsoft/uf2 cf3bd7f9 utils/uf2families.json\",\n    numbering_group_count: 1,\n    missing_block_count: 0,\n    ambiguous_numbering_group_count: 0,\n    repeated_block_count: 0,\n    out_of_order_block_count: 0,\n    block_number_out_of_range_count: 0,\n    region_count: 1,\n    data_bytes: 1000,\n    duplicate_bytes: 0,\n  });\n});\n\nit(\"keeps gaps between regions and sorts blocks that arrive out of order\", () => {\n  const payload = patternBytes(768);\n  const [first, second, third, late] = [0, 1, 2, 3].map((blockNo) =>\n    uf2Block({\n      address: blockNo === 3 ? 0x1000_1000 : 0x1000_0000 + blockNo * 256,\n      payload:\n        blockNo === 3\n          ? [0xaa, 0xbb]\n          : payload.subarray(blockNo * 256, (blockNo + 1) * 256),\n      blockNo,\n      numBlocks: 4,\n      familyId: RP2040_FAMILY,\n    }),\n  );\n  const decoded = image(uf2File([late!, third!, first!, second!]));\n  expect(Buffer.compare(decoded.regions[0]!.bytes, payload)).toBe(0);\n  expect(regionFacts(decoded)).toEqual([\n    expect.objectContaining({\n      start: 0x1000_0000,\n      end: 0x1000_02ff,\n      blockCount: 3,\n      firstFileBlock: 1,\n      lastFileBlock: 3,\n    }),\n    expect.objectContaining({\n      start: 0x1000_1000,\n      end: 0x1000_1001,\n      blockCount: 1,\n      firstFileBlock: 0,\n      lastFileBlock: 0,\n    }),\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    out_of_order_block_count: 2,\n    missing_block_count: 0,\n    region_count: 2,\n    data_bytes: 770,\n  });\n  expect(decoded.complete).toBe(true);\n});\n\nit(\"counts identical rewrites and refuses a conflicting rewrite of one address\", () => {\n  const first = uf2Block({\n    address: 0x2000_0000,\n    payload: [1, 2, 3, 4],\n    blockNo: 0,\n    numBlocks: 2,\n    familyId: RP2040_FAMILY,\n  });\n  const same = uf2Block({\n    address: 0x2000_0002,\n    payload: [3, 4, 5],\n    blockNo: 1,\n    numBlocks: 2,\n    familyId: RP2040_FAMILY,\n  });\n  const decoded = image(uf2File([first, same]));\n  expect(decoded.metadata).toMatchObject({\n    duplicate_bytes: 2,\n    data_bytes: 5,\n  });\n  expect(\n    Buffer.compare(decoded.regions[0]!.bytes, Uint8Array.from([1, 2, 3, 4, 5])),\n  ).toBe(0);\n  const different = uf2Block({\n    address: 0x2000_0002,\n    payload: [3, 9],\n    blockNo: 1,\n    numBlocks: 2,\n    familyId: RP2040_FAMILY,\n  });\n  expect(decode(uf2File([first, different]))).toEqual({\n    ok: false,\n    error: {\n      kind: \"format\",\n      message: expect.stringMatching(\n        /0xe48bff56\\b.*RP2040.*0x20000003\\b.*different values.*block 0\\b.*0x04\\b.*block 1\\b.*0x09\\b/iu,\n      ),\n    },\n  });\n});\n\nit(\"keeps families apart even when they target the same addresses\", () => {\n  // A Pico SDK universal image: an RP2350 absolute block, then RP2040 and RP2350 images.\n  const absolute = uf2Block({\n    address: 0x10ff_ff00,\n    payload: new Uint8Array(256).fill(0xef),\n    blockNo: 0,\n    numBlocks: 2,\n    familyId: RP2XXX_ABSOLUTE_FAMILY,\n  });\n  const decoded = image(\n    uf2File([\n      absolute,\n      ...uf2Image(RP2040_FAMILY, 0x1000_0000, patternBytes(512, 1)),\n      ...uf2Image(RP2350_ARM_S_FAMILY, 0x1000_0000, patternBytes(512, 2)),\n    ]),\n  );\n  expect(\n    decoded.regions.map(({ familyId, start, end }) => [familyId, start, end]),\n  ).toEqual([\n    [RP2040_FAMILY, 0x1000_0000, 0x1000_01ff],\n    [RP2XXX_ABSOLUTE_FAMILY, 0x10ff_ff00, 0x10ff_ffff],\n    [RP2350_ARM_S_FAMILY, 0x1000_0000, 0x1000_01ff],\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    family_count: 3,\n    numbering_group_count: 3,\n    missing_block_count: 1,\n    duplicate_bytes: 0,\n  });\n  expect(decoded.complete).toBe(false);\n  expect(decoded.limitations).toEqual([\n    expect.stringMatching(\n      /1 block.*absent.*0xe48bff57.*2 numbered blocks.*1/iu,\n    ),\n  ]);\n});\n\nit(\"names the LibreTiny families that the cited registry lists\", () => {\n  // LibreTiny also builds LN882H (0xa38090a8), which that registry omits.\n  const families = new Map<number, string | null>([\n    [0x9fff_d543, \"RTL8710A\"],\n    [0x22e0_d6fc, \"RTL8710B\"],\n    [0xe08f_7564, \"RTL8720C\"],\n    [0x3379_cfe2, \"RTL8720D\"],\n    [0x675a_40b0, \"BK7231U\"],\n    [0x7b3e_f230, \"BK7231N\"],\n    [0x6a82_cc42, \"BK7251\"],\n    [0xde12_70b7, \"BL602\"],\n    [0xa380_90a8, null],\n  ]);\n  const decoded = image(\n    uf2File(\n      [...families.keys()].flatMap((familyId) =>\n        uf2Image(familyId, 0x0, patternBytes(256)),\n      ),\n    ),\n  );\n  expect(\n    new Map(\n      decoded.regions.map(({ familyId, familyName }) => [familyId, familyName]),\n    ),\n  ).toEqual(families);\n});\n\nit(\"reports numbered blocks that are absent and leaves coverage unknown\", () => {\n  const blocks = uf2Image(RP2040_FAMILY, 0x1000_0000, patternBytes(1024));\n  const decoded = image(uf2File([blocks[0]!, blocks[1]!, blocks[3]!]));\n  expect(decoded.complete).toBe(false);\n  expect(decoded.metadata).toMatchObject({\n    missing_block_count: 1,\n    region_count: 2,\n  });\n  expect(decoded.limitations).toEqual([\n    expect.stringMatching(\n      /1 block.*absent.*0xe48bff56.*4 numbered blocks.*3/iu,\n    ),\n  ]);\n});\n\nit(\"keeps equal-sized esptool copies complete and an identical resend complete\", () => {\n  // esptool numbers each merged file from 0, so equal-sized files reuse numbers.\n  const decoded = image(\n    uf2File([\n      ...uf2Image(0xc47e_5767, 0x0, patternBytes(512, 3)),\n      ...uf2Image(0xc47e_5767, 0x8000, patternBytes(512, 4)),\n    ]),\n  );\n  expect(decoded.metadata).toMatchObject({\n    numbering_group_count: 1,\n    repeated_block_count: 2,\n    out_of_order_block_count: 1,\n    missing_block_count: 0,\n    ambiguous_numbering_group_count: 0,\n    family_count: 1,\n    region_count: 2,\n  });\n  expect(decoded.complete).toBe(true);\n  expect(decoded.regions[1]?.familyName).toBe(\"ESP32S3\");\n  // A block sent twice to its own address is one block, not a second copy.\n  const blocks = uf2Image(RP2040_FAMILY, 0x1000_0000, patternBytes(512));\n  const resent = image(uf2File([blocks[0]!, blocks[1]!, blocks[1]!]));\n  expect(resent.complete).toBe(true);\n  expect(resent.metadata).toMatchObject({\n    repeated_block_count: 1,\n    duplicate_bytes: 256,\n    ambiguous_numbering_group_count: 0,\n  });\n});\n\nit(\"leaves coverage unknown when one copy of reused numbering lost a block\", () => {\n  const first = uf2Image(0xc47e_5767, 0x0, patternBytes(768, 5));\n  const second = uf2Image(0xc47e_5767, 0x8000, patternBytes(768, 6));\n  for (const lost of [first[1]!, second[2]!]) {\n    const decoded = image(\n      uf2File([...first, ...second].filter((block) => block !== lost)),\n    );\n    expect(decoded.complete).toBe(false);\n    expect(decoded.metadata).toMatchObject({\n      missing_block_count: 0,\n      ambiguous_numbering_group_count: 1,\n    });\n    expect(decoded.limitations).toEqual([\n      expect.stringMatching(\n        /numbering.*complete.*0xc47e5767.*ESP32S3.*3.*1 address.*2/iu,\n      ),\n    ]);\n  }\n});\n\nit(\"excludes not-main-flash and file-container blocks from regions\", () => {\n  const flash = uf2Block({\n    address: 0x0,\n    payload: [1, 2],\n    blockNo: 0,\n    numBlocks: 3,\n  });\n  const comment = uf2Block({\n    address: 0x0,\n    payload: [9, 9, 9],\n    blockNo: 1,\n    numBlocks: 3,\n    flags: UF2_FLAGS.notMainFlash,\n  });\n  const decoded = image(uf2File([flash, comment]));\n  expect(regionFacts(decoded)).toEqual([\n    {\n      familyId: null,\n      familyName: null,\n      start: 0,\n      end: 1,\n      length: 2,\n      blockCount: 1,\n      firstFileBlock: 0,\n      lastFileBlock: 0,\n    },\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    not_main_flash_block_count: 1,\n    flash_block_count: 1,\n    family_count: 0,\n    missing_block_count: 1,\n  });\n  expect(decoded.limitations).toContainEqual(\n    expect.stringMatching(\n      /1 UF2 block.*not main flash.*0x1.*3 payload bytes.*no region/iu,\n    ),\n  );\n  const file = uf2Block({\n    address: 0,\n    payload: [0x41],\n    blockNo: 2,\n    numBlocks: 3,\n    fileSize: 1,\n    flags: UF2_FLAGS.fileContainer | UF2_FLAGS.notMainFlash,\n  });\n  const contained = image(uf2File([flash, comment, file]));\n  expect(contained.complete).toBe(false);\n  expect(contained.metadata).toMatchObject({\n    file_container_block_count: 1,\n    not_main_flash_block_count: 1,\n    missing_block_count: 0,\n    region_count: 1,\n  });\n  expect(contained.limitations).toContainEqual(\n    expect.stringMatching(\n      /1 UF2 block.*file containers.*0x1000.*not reconstructed/iu,\n    ),\n  );\n});\n\nit(\"excludes invalid blocks and a truncated final block, leaving coverage unknown\", () => {\n  const blocks = uf2Image(RP2040_FAMILY, 0x1000_0000, patternBytes(768));\n  const badEnd = uf2Block({\n    address: 0x1000_0100,\n    payload: patternBytes(256),\n    blockNo: 1,\n    numBlocks: 3,\n    familyId: RP2040_FAMILY,\n    magics: [0x0a32_4655, 0x9e5d_5157, 0],\n  });\n  const oversized = uf2Block({\n    address: 0x1000_0300,\n    payload: [1],\n    declaredSize: 477,\n    blockNo: 2,\n    numBlocks: 3,\n    familyId: RP2040_FAMILY,\n  });\n  const wrapping = uf2Block({\n    address: 0xffff_ffff,\n    payload: [1, 2],\n    blockNo: 0,\n    numBlocks: 1,\n  });\n  const decoded = image(\n    uf2File([\n      blocks[0]!,\n      badEnd,\n      blocks[2]!,\n      oversized,\n      wrapping,\n      blocks[1]!.subarray(0, 100),\n    ]),\n  );\n  expect(decoded.metadata).toMatchObject({\n    block_count: 5,\n    trailing_bytes: 100,\n    invalid_block_count: 3,\n    flash_block_count: 2,\n    missing_block_count: 1,\n    region_count: 2,\n  });\n  expect(decoded.complete).toBe(false);\n  expect(decoded.limitations).toEqual([\n    expect.stringMatching(/100 bytes.*512.byte block.*may be truncated/iu),\n    expect.stringMatching(/3 UF2 block.*invalid.*block 1.*offset 512.*magic/iu),\n    expect.stringMatching(\n      /1 block.*absent.*0xe48bff56.*3 numbered blocks.*2/iu,\n    ),\n  ]);\n});\n\nit(\"reports block numbers outside their declared count\", () => {\n  const decoded = image(\n    uf2File([\n      uf2Block({ address: 0, payload: [1], blockNo: 1, numBlocks: 1 }),\n      uf2Block({ address: 1, payload: [2], blockNo: 0, numBlocks: 0 }),\n    ]),\n  );\n  expect(decoded.metadata).toMatchObject({\n    block_number_out_of_range_count: 2,\n    numbering_group_count: 0,\n    region_count: 1,\n    data_bytes: 2,\n  });\n  expect(decoded.complete).toBe(false);\n});\n\nit(\"counts MD5 and extension-tag flags as declared, unverified facts\", () => {\n  const decoded = image(\n    uf2File([\n      uf2Block({\n        address: 0,\n        payload: [1],\n        blockNo: 0,\n        numBlocks: 2,\n        flags: UF2_FLAGS.md5,\n      }),\n      uf2Block({\n        address: 1,\n        payload: [2],\n        blockNo: 1,\n        numBlocks: 2,\n        flags: UF2_FLAGS.extensionTags,\n      }),\n    ]),\n  );\n  expect(decoded.metadata).toMatchObject({\n    md5_block_count: 1,\n    extension_tag_block_count: 1,\n    region_count: 1,\n  });\n  expect(decoded.complete).toBe(true);\n  expect(decoded.limitations).toEqual([\n    expect.stringMatching(\n      /1.*MD5.*0x4000.*1.*extension.*0x8000.*not decoded or verified/iu,\n    ),\n  ]);\n});\n\nit(\"accepts boundary blocks beside the invalid ones\", () => {\n  const decoded = image(\n    uf2File([\n      // A full 476-byte payload ends exactly at the top of the address space.\n      uf2Block({\n        address: 0xffff_ffff - 475,\n        payload: patternBytes(476),\n        blockNo: 0,\n        numBlocks: 3,\n        familyId: RP2040_FAMILY,\n      }),\n      // A main-flash block may carry no payload.\n      uf2Block({\n        address: 0x1000_0000,\n        payload: [],\n        blockNo: 1,\n        numBlocks: 3,\n        familyId: RP2040_FAMILY,\n      }),\n      // Blocks without a familyID form their own address space.\n      uf2Block({\n        address: 0xffff_ffff - 475,\n        payload: patternBytes(476, 1),\n        blockNo: 0,\n        numBlocks: 1,\n      }),\n      uf2Block({\n        address: 0x1000_0000,\n        payload: [7],\n        blockNo: 2,\n        numBlocks: 3,\n        familyId: RP2040_FAMILY,\n      }),\n    ]),\n  );\n  expect(decoded.complete).toBe(true);\n  expect(\n    decoded.regions.map(({ familyId, start, end }) => [familyId, start, end]),\n  ).toEqual([\n    [null, 0xffff_fe24, 0xffff_ffff],\n    [RP2040_FAMILY, 0x1000_0000, 0x1000_0000],\n    [RP2040_FAMILY, 0xffff_fe24, 0xffff_ffff],\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    invalid_block_count: 0,\n    flash_block_count: 4,\n    family_count: 1,\n    numbering_group_count: 2,\n  });\n});\n\nit(\"refuses a larger file than its decoder admitted with a typed limit\", () => {\n  const block = uf2Block({\n    address: 0,\n    payload: [1],\n    blockNo: 0,\n    numBlocks: 1,\n  });\n  const decoder = createUf2Decoder(511);\n  if (!decoder.ok) throw new Error(decoder.error.message);\n  expect(decoder.value.write(block)).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"file-size\" },\n  });\n});\n\nit(\"refuses files above the fixed ceiling and more regions than retained\", () => {\n  expect(createUf2Decoder(UF2_MAX_FILE_BYTES + 1)).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"file-size\" },\n  });\n  const blocks = (count: number) =>\n    Array.from({ length: count }, (_, index) =>\n      uf2Block({ address: index * 2, payload: [1], blockNo: 0, numBlocks: 1 }),\n    );\n  const accepted = decode(uf2File(blocks(65_536)), 512 * 1024);\n  if (!accepted.ok) throw new Error(accepted.error.message);\n  expect(accepted.value.metadata.region_count).toBe(65_536);\n  expect(decode(uf2File(blocks(65_537)), 512 * 1024)).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"capacity\" },\n  });\n  // Runs are not capped: blocks in reverse order still merge into one region.\n  const reversed = Array.from({ length: 70_000 }, (_, index) =>\n    uf2Block({\n      address: (69_999 - index) * 4,\n      payload: [1, 2, 3, 4],\n      blockNo: 0,\n      numBlocks: 1,\n    }),\n  );\n  const merged = decode(uf2File(reversed), 512 * 1024);\n  if (!merged.ok) throw new Error(merged.error.message);\n  expect(merged.value.metadata).toMatchObject({\n    region_count: 1,\n    data_bytes: 280_000,\n  });\n});\n\nit(\"bounds numbering descriptions while retaining every group and payload\", () => {\n  const families = Array.from({ length: 9 }, (_, index) => 0x1009 - index);\n  const decoded = image(\n    uf2File([\n      ...families.flatMap((familyId, index) =>\n        [0, 8, 4].map((offset, ordinal) =>\n          uf2Block({\n            address: 0x0800_0000 + offset,\n            payload: [index + ordinal + 1, 0xa5, 0x5a, 0xff],\n            blockNo: ordinal === 2 ? 1 : 0,\n            numBlocks: 3,\n            familyId,\n          }),\n        ),\n      ),\n      uf2Block({\n        address: 0x1000,\n        payload: [0xde, 0xad, 0xbe, 0xef],\n        blockNo: 0,\n        numBlocks: 1,\n        familyId: 0x2000,\n      }),\n    ]),\n    37,\n  );\n  expect(decoded.metadata).toMatchObject({\n    block_count: 28,\n    flash_block_count: 28,\n    family_count: 10,\n    numbering_group_count: 10,\n    missing_block_count: 9,\n    ambiguous_numbering_group_count: 9,\n    repeated_block_count: 9,\n    out_of_order_block_count: 9,\n    region_count: 10,\n    data_bytes: 112,\n    duplicate_bytes: 0,\n  });\n  expect(decoded.complete).toBe(false);\n  expect(decoded.limitations).toEqual([\n    \"UF2 numbering declares 9 block(s) that are absent: \" +\n      \"family 0x00001009 with 3 numbered blocks has 2 of them; \" +\n      \"family 0x00001008 with 3 numbered blocks has 2 of them; \" +\n      \"family 0x00001007 with 3 numbered blocks has 2 of them; \" +\n      \"family 0x00001006 with 3 numbered blocks has 2 of them; and 5 more.\",\n    \"UF2 numbering cannot show that every copy of a block sequence is complete: \" +\n      \"family 0x00001009 with 3 numbered blocks has some numbers at 1 address(es) and others at 2; \" +\n      \"family 0x00001008 with 3 numbered blocks has some numbers at 1 address(es) and others at 2; \" +\n      \"family 0x00001007 with 3 numbered blocks has some numbers at 1 address(es) and others at 2; \" +\n      \"family 0x00001006 with 3 numbered blocks has some numbers at 1 address(es) and others at 2; and 5 more.\",\n  ]);\n  expect(regionFacts(decoded)).toEqual([\n    ...families.toReversed().map((familyId) => {\n      const fileIndex = families.indexOf(familyId) * 3;\n      return {\n        familyId,\n        familyName: null,\n        start: 0x0800_0000,\n        end: 0x0800_000b,\n        length: 12,\n        blockCount: 3,\n        firstFileBlock: fileIndex,\n        lastFileBlock: fileIndex + 2,\n      };\n    }),\n    {\n      familyId: 0x2000,\n      familyName: null,\n      start: 0x1000,\n      end: 0x1003,\n      length: 4,\n      blockCount: 1,\n      firstFileBlock: 27,\n      lastFileBlock: 27,\n    },\n  ]);\n  expect(decoded.regions.map((region) => [...region.bytes])).toEqual([\n    ...families.toReversed().map((familyId) => {\n      const index = families.indexOf(familyId);\n      return [\n        index + 1,\n        0xa5,\n        0x5a,\n        0xff,\n        index + 3,\n        0xa5,\n        0x5a,\n        0xff,\n        index + 2,\n        0xa5,\n        0x5a,\n        0xff,\n      ];\n    }),\n    [0xde, 0xad, 0xbe, 0xef],\n  ]);\n});\n"}
