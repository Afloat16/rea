2026-11-17T06:43:22.7736846Z REA_DFUSE_TESTED_SOURCE {"path": "src/domain/firmware/dfuse.ts", "sha256": "8a7f6412009cb87431582c3f786358fe7a4b858da0b08fe2550487ce15ff5f0c", "content": "import {\n  boundedList,\n  describeBoundedList,\n  type BoundedList,\n} from \"../boundedList.js\";\nimport { crc32 } from \"node:zlib\";\n\nimport type { DfuSeMetadata } from \"../artifactFormatMetadata.js\";\nimport { err, ok, type Result } from \"../result.js\";\nimport type { RegionDecodeFailure, RegionDecoder } from \"./regionDecoder.js\";\n\n/** \"DfuSe\", bVersion, DFUImageSize and bTargets (ST UM0391). */\nconst PREFIX_BYTES = 11;\n/** \"Target\", bAlternateSetting, bTargetNamed, szTargetName, dwTargetSize, dwNbElements. */\nconst TARGET_PREFIX_BYTES = 274;\nconst TARGET_NAME_OFFSET = 11;\nconst TARGET_NAME_BYTES = 255;\n/** dwElementAddress and dwElementSize. */\nconst ELEMENT_HEADER_BYTES = 8;\n/** bcdDevice, idProduct, idVendor, bcdDFU, \"UFD\", bLength and dwCRC (DFU 1.1). */\nexport const DFUSE_SUFFIX_BYTES = 16;\nconst DFUSE_VERSION = 1;\nconst DFU_SUFFIX_VERSION = 0x011a;\nconst ADDRESS_SPACE = 0x1_0000_0000;\n/** Elements named in one limitation before the rest are counted. */\nconst NAMED_ELEMENTS = 4;\nconst SIGNATURE = [0x44, 0x66, 0x75, 0x53, 0x65];\nconst TARGET_SIGNATURE = [0x54, 0x61, 0x72, 0x67, 0x65, 0x74];\nconst SUFFIX_SIGNATURE = [0x55, 0x46, 0x44];\n\n/**\n * Fixed whole-file ceiling, as for Intel HEX; configurable ceilings are\n * tracked in #6176. The decoder holds the file once and slices elements from it.\n */\nexport const DFUSE_MAX_FILE_BYTES = 128 * 1024 * 1024;\n/** Non-empty elements retained as inventory entries, as for UF2 regions. */\nexport const DFUSE_MAX_ELEMENTS = 65_536;\n\n/** One element: bytes the file declares for an address in one alternate setting. */\nexport interface DfuSeElement {\n  readonly targetIndex: number;\n  readonly alternateSetting: number;\n  /** szTargetName up to its first NUL, one character per byte; null when unnamed. */\n  readonly targetName: string | null;\n  readonly elementIndex: number;\n  readonly address: number;\n  /** The file offset of the element data. */\n  readonly dataOffset: number;\n  readonly bytes: Uint8Array;\n}\n\nexport interface DfuSeImage {\n  readonly metadata: DfuSeMetadata;\n  /** In file order; empty elements are counted in metadata but not listed. */\n  readonly elements: readonly DfuSeElement[];\n  readonly limitations: readonly string[];\n}\n\nconst readUint16 = (bytes: Uint8Array, offset: number): number =>\n  (bytes[offset] ?? 0) | ((bytes[offset + 1] ?? 0) << 8);\n\nconst readUint32 = (bytes: Uint8Array, offset: number): number =>\n  (readUint16(bytes, offset) | (readUint16(bytes, offset + 2) << 16)) >>> 0;\n\nconst startsWith = (\n  bytes: Uint8Array,\n  offset: number,\n  signature: readonly number[],\n): boolean => signature.every((byte, index) => bytes[offset + index] === byte);\n\nconst hex32 = (value: number): string =>\n  `0x${value.toString(16).padStart(8, \"0\")}`;\n\n/** Whether the leading bytes begin a DfuSe version 1 image. */\nexport const hasDfuSePrefix = (prefix: Uint8Array): boolean =>\n  startsWith(prefix, 0, SIGNATURE) && prefix[5] === DFUSE_VERSION;\n\n/** Whether the final 16 bytes are a DFU 1.1a suffix, as DfuSe requires. */\nconst hasDfuSeSuffix = (suffix: Uint8Array): boolean =>\n  suffix.length === DFUSE_SUFFIX_BYTES &&\n  readUint16(suffix, 6) === DFU_SUFFIX_VERSION &&\n  startsWith(suffix, 8, SUFFIX_SIGNATURE) &&\n  suffix[11] === DFUSE_SUFFIX_BYTES;\n\n/**\n * Recognize a file only by the DfuSe prefix and the DFU suffix together. The\n * suffix CRC is not part of recognition: a mismatch is an integrity fact.\n */\nexport const isDfuSeFile = (\n  prefix: Uint8Array,\n  suffix: Uint8Array,\n  fileBytes: number,\n): boolean =>\n  fileBytes >= PREFIX_BYTES + DFUSE_SUFFIX_BYTES &&\n  hasDfuSePrefix(prefix) &&\n  hasDfuSeSuffix(suffix);\n\n/** Start a decoder that holds at most the admitted file size. */\nexport const createDfuSeDecoder = (\n  fileBytes: number,\n): Result<RegionDecoder<DfuSeImage>, RegionDecodeFailure> =>\n  Number.isSafeInteger(fileBytes) &&\n  fileBytes >= 0 &&\n  fileBytes <= DFUSE_MAX_FILE_BYTES\n    ? ok(new RetainingDfuSeDecoder(fileBytes))\n    : err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: `file is ${String(fileBytes)} bytes, exceeding the fixed ${String(DFUSE_MAX_FILE_BYTES)}-byte (128 MiB) ceiling`,\n      });\n\n/** The DFU suffix CRC: CRC-32 without the final inversion, over every byte before dwCRC. */\nconst dfuCrc = (bytes: Uint8Array): number => ~crc32(bytes) >>> 0;\n\nconst formatFailure = (\n  offset: number,\n  detail: string,\n): RegionDecodeFailure => ({\n  kind: \"format\",\n  message: `byte offset ${String(offset)}: ${detail}`,\n});\n\n/** At most NAMED_ELEMENTS descriptions, then a count of the rest of `total`. */\nconst named = (items: readonly string[], total = items.length): string =>\n  describeBoundedList(\n    boundedList(items, NAMED_ELEMENTS, total - items.length),\n    \"; \",\n  );\n\nclass RetainingDfuSeDecoder implements RegionDecoder<DfuSeImage> {\n  readonly #bytes: Uint8Array;\n  #length = 0;\n\n  constructor(fileBytes: number) {\n    this.#bytes = new Uint8Array(fileBytes);\n  }\n\n  write(chunk: Uint8Array): Result<void, RegionDecodeFailure> {\n    if (this.#length + chunk.length > this.#bytes.length)\n      return err({\n        kind: \"limit\",\n        boundary: \"file-size\",\n        message: \"file grew beyond its admitted size while being read\",\n      });\n    this.#bytes.set(chunk, this.#length);\n    this.#length += chunk.length;\n    return ok(undefined);\n  }\n\n  finish(): Result<DfuSeImage, RegionDecodeFailure> {\n    return parseDfuSe(this.#bytes.subarray(0, this.#length));\n  }\n}\n\nconst parseDfuSe = (\n  bytes: Uint8Array,\n): Result<DfuSeImage, RegionDecodeFailure> => {\n  const suffixStart = bytes.length - DFUSE_SUFFIX_BYTES;\n  if (\n    bytes.length < PREFIX_BYTES + DFUSE_SUFFIX_BYTES ||\n    !hasDfuSePrefix(bytes) ||\n    !hasDfuSeSuffix(bytes.subarray(suffixStart))\n  )\n    return err(\n      formatFailure(\n        0,\n        \"the file does not begin with a DfuSe prefix and end with a DFU 1.1a suffix\",\n      ),\n    );\n  // UM0391 calls DFUImageSize the file length, which dfu-util's dfuse-pack.py\n  // writes since ee6b393d (2020-10-08). Earlier dfuse-pack.py and MicroPython's\n  // tools/dfu.py write the length before the suffix.\n  const imageSize = readUint32(bytes, 6);\n  const suffixCrc = readUint32(bytes, suffixStart + 12);\n  const computedCrc = dfuCrc(bytes.subarray(0, bytes.length - 4));\n  if (imageSize !== suffixStart && imageSize !== bytes.length)\n    return err(\n      formatFailure(\n        6,\n        `DFUImageSize declares ${String(imageSize)} bytes, but the DFU suffix begins at byte ${String(suffixStart)} and the file holds ${String(bytes.length)} bytes; the suffix CRC ${suffixCrc === computedCrc ? \"matches\" : \"does not match\"} the file`,\n      ),\n    );\n  const targetCount = bytes[10] ?? 0;\n  const walk = new TargetWalk(bytes, suffixStart);\n  let offset = PREFIX_BYTES;\n  for (let targetIndex = 0; targetIndex < targetCount; targetIndex += 1) {\n    const next = walk.target(targetIndex, offset);\n    if (!next.ok) return next;\n    offset = next.value;\n  }\n  if (offset !== suffixStart)\n    return err(\n      formatFailure(\n        offset,\n        `${String(targetCount)} target(s) end at byte ${String(offset)}, but the DFU suffix begins at byte ${String(suffixStart)}`,\n      ),\n    );\n  const { elements } = walk;\n  const overlaps = overlappingElements(elements);\n  const overlapCount = overlaps.items.length + overlaps.omitted;\n  return ok({\n    metadata: {\n      kind: \"dfuse\",\n      image_size: imageSize,\n      target_count: targetCount,\n      element_count: walk.elementCount,\n      empty_element_count: walk.emptyElements,\n      overlapping_element_count: overlapCount,\n      data_bytes: elements.reduce(\n        (sum, element) => sum + element.bytes.length,\n        0,\n      ),\n      device_version: readUint16(bytes, suffixStart),\n      product_id: readUint16(bytes, suffixStart + 2),\n      vendor_id: readUint16(bytes, suffixStart + 4),\n      suffix_crc: suffixCrc,\n      computed_crc: computedCrc,\n    },\n    elements,\n    limitations: [\n      ...(overlapCount === 0\n        ? []\n        : [\n            `${String(overlapCount)} DfuSe element(s) overlap an element earlier in address order within the same alternate setting; each stays a separate entry and no bytes were merged: ${describeBoundedList(overlaps, \"; \")}.`,\n          ]),\n      ...(walk.unlistedCount === 0\n        ? []\n        : [\n            `DfuSe declarations without bytes have no entry: ${named(walk.unlisted, walk.unlistedCount)}.`,\n          ]),\n    ],\n  });\n};\n\n/** Targets and elements in file order; every size is checked against its container. */\nclass TargetWalk {\n  readonly elements: DfuSeElement[] = [];\n  /**\n   * The first NAMED_ELEMENTS empty elements and element-less targets, which no\n   * entry can show. A file can hold millions of empty elements, so the rest\n   * are only counted in `unlistedCount`.\n   */\n  readonly unlisted: string[] = [];\n  unlistedCount = 0;\n  elementCount = 0;\n  emptyElements = 0;\n\n  constructor(\n    private readonly bytes: Uint8Array,\n    private readonly suffixStart: number,\n  ) {}\n\n  /** Parse one target at `offset`; the result is the offset after its elements. */\n  target(\n    targetIndex: number,\n    offset: number,\n  ): Result<number, RegionDecodeFailure> {\n    const { bytes } = this;\n    if (offset + TARGET_PREFIX_BYTES > this.suffixStart)\n      return err(\n        formatFailure(\n          offset,\n          `target ${String(targetIndex)} prefix needs ${String(TARGET_PREFIX_BYTES)} bytes, but the image ends at byte ${String(this.suffixStart)}`,\n        ),\n      );\n    if (!startsWith(bytes, offset, TARGET_SIGNATURE))\n      return err(\n        formatFailure(\n          offset,\n          `target ${String(targetIndex)} does not begin with the \"Target\" signature`,\n        ),\n      );\n    const targetSize = readUint32(bytes, offset + 266);\n    const declaredElements = readUint32(bytes, offset + 270);\n    const bodyStart = offset + TARGET_PREFIX_BYTES;\n    const bodyEnd = bodyStart + targetSize;\n    if (bodyEnd > this.suffixStart)\n      return err(\n        formatFailure(\n          offset + 266,\n          `target ${String(targetIndex)} declares ${String(targetSize)} bytes, but the image ends at byte ${String(this.suffixStart)}`,\n        ),\n      );\n    const target = {\n      targetIndex,\n      alternateSetting: bytes[offset + 6] ?? 0,\n      targetName:\n        readUint32(bytes, offset + 7) === 0\n          ? null\n          : latin1UntilNul(\n              bytes.subarray(\n                offset + TARGET_NAME_OFFSET,\n                offset + TARGET_NAME_OFFSET + TARGET_NAME_BYTES,\n              ),\n            ),\n    };\n    if (declaredElements === 0)\n      this.#unlisted(\n        () =>\n          `target ${String(targetIndex)} (alternate setting ${String(target.alternateSetting)}) declares no elements`,\n      );\n    let position = bodyStart;\n    for (let index = 0; index < declaredElements; index += 1) {\n      const next = this.#element(target, index, position, bodyEnd);\n      if (!next.ok) return next;\n      position = next.value;\n    }\n    return position === bodyEnd\n      ? ok(bodyEnd)\n      : err(\n          formatFailure(\n            position,\n            `target ${String(targetIndex)} declares ${String(targetSize)} bytes, but its ${String(declaredElements)} element(s) end ${String(bodyEnd - position)} bytes earlier`,\n          ),\n        );\n  }\n\n  #element(\n    target: Pick<\n      DfuSeElement,\n      \"targetIndex\" | \"alternateSetting\" | \"targetName\"\n    >,\n    elementIndex: number,\n    position: number,\n    bodyEnd: number,\n  ): Result<number, RegionDecodeFailure> {\n    const name = `target ${String(target.targetIndex)} element ${String(elementIndex)}`;\n    if (position + ELEMENT_HEADER_BYTES > bodyEnd)\n      return err(\n        formatFailure(\n          position,\n          `${name} header lies beyond the target's end at byte ${String(bodyEnd)}`,\n        ),\n      );\n    const address = readUint32(this.bytes, position);\n    const size = readUint32(this.bytes, position + 4);\n    const dataOffset = position + ELEMENT_HEADER_BYTES;\n    if (dataOffset + size > bodyEnd)\n      return err(\n        formatFailure(\n          position + 4,\n          `${name} declares ${String(size)} bytes, but its target ends at byte ${String(bodyEnd)}`,\n        ),\n      );\n    if (address + size > ADDRESS_SPACE)\n      return err(\n        formatFailure(\n          position,\n          `${name} at ${hex32(address)} with ${String(size)} bytes wraps past 0xffffffff`,\n        ),\n      );\n    if (size > 0 && this.elements.length >= DFUSE_MAX_ELEMENTS)\n      return err({\n        kind: \"limit\",\n        boundary: \"capacity\",\n        message: `byte offset ${String(position)}: the file holds more than ${String(DFUSE_MAX_ELEMENTS)} elements with bytes, the most retained as entries`,\n      });\n    this.elementCount += 1;\n    if (size === 0) {\n      this.emptyElements += 1;\n      this.#unlisted(\n        () =>\n          `${name} at ${hex32(address)} (alternate setting ${String(target.alternateSetting)}) holds no bytes`,\n      );\n    } else\n      this.elements.push({\n        ...target,\n        elementIndex,\n        address,\n        dataOffset,\n        bytes: this.bytes.subarray(dataOffset, dataOffset + size),\n      });\n    return ok(dataOffset + size);\n  }\n\n  /** Count a declaration without bytes; describe only the first few. */\n  #unlisted(describe: () => string): void {\n    this.unlistedCount += 1;\n    if (this.unlisted.length < NAMED_ELEMENTS) this.unlisted.push(describe());\n  }\n}\n\n/** szTargetName is a fixed field; bytes after the first NUL are padding. */\nconst latin1UntilNul = (field: Uint8Array): string => {\n  const end = field.indexOf(0);\n  return String.fromCharCode(\n    ...field.subarray(0, end < 0 ? field.length : end),\n  );\n};\n\nconst elementText = (element: DfuSeElement): string =>\n  `target ${String(element.targetIndex)} element ${String(element.elementIndex)} (${hex32(element.address)}-${hex32(element.address + element.bytes.length - 1)})`;\n\n/** Elements that overlap an earlier one in address order within one alternate setting. */\nconst overlappingElements = (\n  elements: readonly DfuSeElement[],\n): BoundedList<string> => {\n  const ordered = [...elements].sort(\n    (left, right) =>\n      left.alternateSetting - right.alternateSetting ||\n      left.address - right.address,\n  );\n  const overlaps: string[] = [];\n  let omitted = 0;\n  let reach: DfuSeElement | undefined;\n  for (const element of ordered) {\n    if (\n      reach !== undefined &&\n      reach.alternateSetting === element.alternateSetting &&\n      element.address < reach.address + reach.bytes.length\n    ) {\n      if (overlaps.length < NAMED_ELEMENTS)\n        overlaps.push(\n          `${elementText(element)} overlaps ${elementText(reach)} in alternate setting ${String(element.alternateSetting)}`,\n        );\n      else omitted += 1;\n    }\n    if (\n      reach === undefined ||\n      reach.alternateSetting !== element.alternateSetting ||\n      element.address + element.bytes.length >\n        reach.address + reach.bytes.length\n    )\n      reach = element;\n  }\n  return boundedList(overlaps, NAMED_ELEMENTS, omitted);\n};\n"}
2026-11-17T06:43:22.7812202Z REA_DFUSE_TESTED_TESTS {"path": "src/domain/firmware/dfuse.test.ts", "sha256": "6ec846277071be8a3c691121a4ace2c6f3670db9136d985b93b1a3c517b9e0a9", "content": "import { createHash } from \"node:crypto\";\n\nimport { expect, it } from \"vitest\";\n\nimport {\n  DFUSE_MAX_FILE_BYTES,\n  createDfuSeDecoder,\n  isDfuSeFile,\n  type DfuSeImage,\n} from \"./dfuse.js\";\nimport { dfuseFile, type DfuSeFixture } from \"./dfuse.fixture.js\";\n\nconst decode = (bytes: Uint8Array, chunkSize = 64) => {\n  const decoder = createDfuSeDecoder(bytes.length);\n  if (!decoder.ok) throw new Error(decoder.error.message);\n  for (let offset = 0; offset < bytes.length; offset += chunkSize) {\n    const written = decoder.value.write(\n      bytes.subarray(offset, offset + chunkSize),\n    );\n    if (!written.ok) return written;\n  }\n  return decoder.value.finish();\n};\n\nconst image = (bytes: Uint8Array): DfuSeImage => {\n  const decoded = decode(bytes);\n  if (!decoded.ok) throw new Error(decoded.error.message);\n  return decoded.value;\n};\n\nconst recognized = (bytes: Uint8Array): boolean =>\n  isDfuSeFile(bytes.subarray(0, 4096), bytes.subarray(-16), bytes.length);\n\nconst elementFacts = ({ elements }: DfuSeImage) =>\n  elements.map(({ bytes, ...facts }) => ({ ...facts, length: bytes.length }));\n\n/** One 16-byte image at 0x08000000 in target \"ST...\", as the packers below write it. */\nconst DFUSE_PACK_EQUIVALENT: DfuSeFixture = {\n  targets: [\n    {\n      alternateSetting: 0,\n      name: \"ST...\",\n      elements: [{ address: 0x0800_0000, data: [...Array(16).keys()] }],\n    },\n  ],\n  deviceVersion: 0,\n};\n\nit(\"decodes files packed with and without the suffix in DFUImageSize\", () => {\n  // Oracle: build() and compute_crc() of dfu-util's dfuse-pack.py at f9a537c9,\n  // transcribed and run under Python 3. Since ee6b393d it writes DFUImageSize\n  // as PREFIX_SIZE + len(data) + SUFFIX_SIZE, the whole file.\n  const packed = dfuseFile({\n    ...DFUSE_PACK_EQUIVALENT,\n    imageSizeIncludesSuffix: true,\n  });\n  expect(createHash(\"sha256\").update(packed).digest(\"hex\")).toBe(\n    \"4d9f8c231291504484745f0b0586031c8f804d141e964cb33a9b82965f8a69d0\",\n  );\n  expect(image(packed).metadata).toMatchObject({\n    image_size: 325,\n    suffix_crc: 0x2c4c_4f44,\n    computed_crc: 0x2c4c_4f44,\n  });\n  const bytes = dfuseFile(DFUSE_PACK_EQUIVALENT);\n  // Oracle: build() and compute_crc() of MicroPython's tools/dfu.py at\n  // cb99ca98, transcribed and run under Python 3. It writes len(data) + 11,\n  // leaving the suffix out, as dfuse-pack.py did before ee6b393d.\n  expect(bytes.length).toBe(325);\n  expect(createHash(\"sha256\").update(bytes).digest(\"hex\")).toBe(\n    \"65ad96452f1f82cc8b44d30dfe94f268f4fd230a32b30a8826a639b269f7034d\",\n  );\n  const decoded = image(bytes);\n  expect(decoded.metadata).toEqual({\n    kind: \"dfuse\",\n    image_size: 309,\n    target_count: 1,\n    element_count: 1,\n    empty_element_count: 0,\n    overlapping_element_count: 0,\n    data_bytes: 16,\n    device_version: 0,\n    product_id: 0xdf11,\n    vendor_id: 0x0483,\n    suffix_crc: 0x7a37_11da,\n    computed_crc: 0x7a37_11da,\n  });\n  expect(elementFacts(decoded)).toEqual([\n    {\n      targetIndex: 0,\n      alternateSetting: 0,\n      targetName: \"ST...\",\n      elementIndex: 0,\n      address: 0x0800_0000,\n      dataOffset: 293,\n      length: 16,\n    },\n  ]);\n  expect(decoded.limitations).toEqual([]);\n});\n\nit(\"keeps each target's alternate setting and name on its elements\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          name: \"Internal Flash\",\n          elements: [\n            { address: 0x0800_0000, data: [1, 2, 3, 4] },\n            { address: 0x0800_4000, data: [5, 6] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          elements: [{ address: 0x1fff_c000, data: [0xaa, 0x55] }],\n        },\n        {\n          alternateSetting: 2,\n          name: Uint8Array.from([0x4f, 0xe9, 0, 0x58]),\n          elements: [{ address: 0x1fff_7800, data: [] }],\n        },\n      ],\n    }),\n  );\n  expect(\n    decoded.elements.map((element) => [\n      element.targetIndex,\n      element.alternateSetting,\n      element.targetName,\n      element.elementIndex,\n      element.address,\n      [...element.bytes],\n    ]),\n  ).toEqual([\n    [0, 0, \"Internal Flash\", 0, 0x0800_0000, [1, 2, 3, 4]],\n    [0, 0, \"Internal Flash\", 1, 0x0800_4000, [5, 6]],\n    [1, 1, null, 0, 0x1fff_c000, [0xaa, 0x55]],\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    target_count: 3,\n    element_count: 4,\n    empty_element_count: 1,\n    data_bytes: 8,\n  });\n  // A named target's field is read to its first NUL, one character per byte.\n  const named = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 3,\n          name: Uint8Array.from([0x4f, 0xe9, 0, 0x58]),\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    }),\n  );\n  expect(named.elements[0]?.targetName).toBe(\"O\u00e9\");\n});\n\nit(\"reports a suffix CRC mismatch as facts without refusing the file\", () => {\n  const decoded = image(dfuseFile({ ...DFUSE_PACK_EQUIVALENT, crc: 0 }));\n  expect(decoded.metadata).toMatchObject({\n    suffix_crc: 0,\n    computed_crc: 0x7a37_11da,\n  });\n  expect(decoded.elements).toHaveLength(1);\n});\n\nit(\"names overlapping elements within one alternate setting only\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [\n            { address: 0x0800_0000, data: [1, 2, 3, 4] },\n            { address: 0x0800_0002, data: [3, 4] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          elements: [{ address: 0x0800_0000, data: [9] }],\n        },\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0x0800_0003, data: [4, 5] }],\n        },\n      ],\n    }),\n  );\n  expect(decoded.metadata.overlapping_element_count).toBe(2);\n  expect(decoded.limitations).toHaveLength(1);\n  const limitation = decoded.limitations[0];\n  expect(limitation).toMatch(/overlap/iu);\n  expect(limitation).toMatch(/no bytes.*merged/iu);\n  expect(limitation).toMatch(/target 0 element 1[^;]*0x08000002-0x08000003/iu);\n  expect(limitation).toMatch(/target 0 element 0[^;]*0x08000000-0x08000003/iu);\n  expect(limitation).toMatch(/target 2 element 0[^;]*0x08000003-0x08000004/iu);\n});\n\nit(\"accepts boundary declarations beside the malformed ones\", () => {\n  // A valid file may hold no targets at all.\n  expect(image(dfuseFile({ targets: [] })).metadata).toMatchObject({\n    image_size: 11,\n    target_count: 0,\n    element_count: 0,\n  });\n  const name = Uint8Array.from({ length: 255 }, () => 0x41);\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 4,\n          // A name filling all 255 bytes has no NUL.\n          name,\n          elements: [\n            // An element may end exactly at the top of the address space.\n            { address: 0xffff_fffe, data: [1, 2] },\n            { address: 0x2000_0000, data: [] },\n          ],\n        },\n        { alternateSetting: 5, elements: [] },\n      ],\n    }),\n  );\n  expect(decoded.elements.map((element) => element.targetName)).toEqual([\n    \"A\".repeat(255),\n  ]);\n  expect(decoded.metadata).toMatchObject({\n    target_count: 2,\n    element_count: 2,\n    empty_element_count: 1,\n  });\n  expect(decoded.limitations).toHaveLength(1);\n  const limitation = decoded.limitations[0];\n  expect(limitation).toMatch(/no entry/iu);\n  expect(limitation).toMatch(\n    /target 0 element 1[^;]*0x20000000[^;]*alternate setting 4/iu,\n  );\n  expect(limitation).toMatch(\n    /target 1[^;]*alternate setting 5[^;]*no elements/iu,\n  );\n});\n\nit(\"recognizes a file only by the DfuSe prefix together with the DFU suffix\", () => {\n  const bytes = dfuseFile(DFUSE_PACK_EQUIVALENT);\n  expect(recognized(bytes)).toBe(true);\n  const changed = (offset: number, value: number): Buffer => {\n    const copy = Buffer.from(bytes);\n    copy[offset] = value;\n    return copy;\n  };\n  expect(recognized(changed(5, 2))).toBe(false);\n  expect(recognized(changed(0, 0x64))).toBe(false);\n  expect(recognized(changed(bytes.length - 10, 0x00))).toBe(false);\n  expect(recognized(changed(bytes.length - 8, 0x58))).toBe(false);\n  expect(recognized(changed(bytes.length - 5, 15))).toBe(false);\n  expect(recognized(bytes.subarray(0, bytes.length - 1))).toBe(false);\n  // The CRC is checked after recognition, so a mismatch still recognizes.\n  expect(recognized(dfuseFile({ ...DFUSE_PACK_EQUIVALENT, crc: 1 }))).toBe(\n    true,\n  );\n});\n\nit.each([\n  [\n    \"a target without its signature\",\n    {\n      targets: [{ alternateSetting: 0, signature: \"Tarxet\", elements: [] }],\n    },\n    'byte offset 11: target 0 does not begin with the \"Target\" signature',\n  ],\n  [\n    \"an element larger than its target\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0, data: [1, 2], declaredSize: 3 }],\n        },\n      ],\n    },\n    \"byte offset 289: target 0 element 0 declares 3 bytes, but its target ends at byte 295\",\n  ],\n  [\n    \"a target larger than the image\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredSize: 100,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 277: target 0 declares 100 bytes, but the image ends at byte 294\",\n  ],\n  [\n    \"fewer elements than the target size\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredElements: 0,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 285: target 0 declares 9 bytes, but its 0 element(s) end 9 bytes earlier\",\n  ],\n  [\n    \"an image size that matches neither packer convention\",\n    { targets: [], imageSize: 12 },\n    \"byte offset 6: DFUImageSize declares 12 bytes, but the DFU suffix begins at byte 11 and the file holds 27 bytes; the suffix CRC matches the file\",\n  ],\n  [\n    \"bytes between the last target and the suffix\",\n    { targets: [], gap: Uint8Array.from([0]) },\n    \"byte offset 11: 0 target(s) end at byte 11, but the DFU suffix begins at byte 12\",\n  ],\n  [\n    \"more targets than the image holds\",\n    { targets: [], declaredTargets: 1 },\n    \"byte offset 11: target 0 prefix needs 274 bytes, but the image ends at byte 11\",\n  ],\n  [\n    \"more elements than the target holds\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          declaredElements: 2,\n          elements: [{ address: 0, data: [1] }],\n        },\n      ],\n    },\n    \"byte offset 294: target 0 element 1 header lies beyond the target's end at byte 294\",\n  ],\n  [\n    \"an element that wraps the address space\",\n    {\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [{ address: 0xffff_ffff, data: [1, 2] }],\n        },\n      ],\n    },\n    \"byte offset 285: target 0 element 0 at 0xffffffff with 2 bytes wraps past 0xffffffff\",\n  ],\n] as const)(\"refuses %s with its byte offset\", (_name, fixture, message) => {\n  expect(decode(dfuseFile(fixture))).toEqual({\n    ok: false,\n    error: { kind: \"format\", message },\n  });\n});\n\nit(\"refuses files above the fixed ceiling and more elements than retained\", () => {\n  expect(createDfuSeDecoder(DFUSE_MAX_FILE_BYTES + 1)).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"file-size\" },\n  });\n  const elements = (count: number, data: readonly number[]) =>\n    Array.from({ length: count }, (_, index) => ({\n      address: index * 2,\n      data,\n    }));\n  const accepted = decode(\n    dfuseFile({\n      targets: [{ alternateSetting: 0, elements: elements(65_536, [1]) }],\n    }),\n    1 << 20,\n  );\n  if (!accepted.ok) throw new Error(accepted.error.message);\n  expect(accepted.value.elements).toHaveLength(65_536);\n  expect(\n    decode(\n      dfuseFile({\n        targets: [{ alternateSetting: 0, elements: elements(65_537, [1]) }],\n      }),\n      1 << 20,\n    ),\n  ).toMatchObject({\n    ok: false,\n    error: { kind: \"limit\", boundary: \"capacity\" },\n  });\n});\n\nit(\"counts empty elements past the entry cap and names only the first four\", () => {\n  // Empty elements have no entry, so they are not capped; 8 header bytes each\n  // let a file hold millions, and only a count and four descriptions are kept.\n  const empty = Array.from({ length: 65_537 }, (_, index) => ({\n    address: index * 2,\n    data: [],\n  }));\n  const decoded = decode(\n    dfuseFile({\n      targets: [\n        { alternateSetting: 0, elements: empty },\n        { alternateSetting: 1, elements: [] },\n      ],\n    }),\n    1 << 20,\n  );\n  if (!decoded.ok) throw new Error(decoded.error.message);\n  expect(decoded.value.elements).toEqual([]);\n  expect(decoded.value.metadata).toMatchObject({\n    element_count: 65_537,\n    empty_element_count: 65_537,\n    data_bytes: 0,\n  });\n  expect(decoded.value.limitations).toHaveLength(1);\n  const limitation = decoded.value.limitations[0];\n  expect(limitation).toMatch(/no entry/iu);\n  for (const [index, address] of [\n    [0, \"0x00000000\"],\n    [1, \"0x00000002\"],\n    [2, \"0x00000004\"],\n    [3, \"0x00000006\"],\n  ] as const)\n    expect(limitation).toMatch(\n      new RegExp(`element ${index}[^;]*${address}`, \"iu\"),\n    );\n  expect(limitation).toContain(\"65534 more\");\n});\n\nit(\"counts every overlap while naming only four in address order\", () => {\n  const decoded = image(\n    dfuseFile({\n      targets: [\n        {\n          alternateSetting: 0,\n          elements: [\n            // File order is reversed; the earliest address is still the owner.\n            ...Array.from({ length: 9 }, (_, index) => ({\n              address: 0x0800_0000 + (8 - index),\n              data: [1, 2, 3, 4],\n            })),\n            { address: 0x0800_0020, data: [9] },\n          ],\n        },\n        {\n          alternateSetting: 1,\n          // A different alternate setting never adds an overlap.\n          elements: [{ address: 0x0800_0000, data: [9] }],\n        },\n      ],\n    }),\n  );\n  expect(decoded.elements).toHaveLength(11);\n  expect(decoded.metadata.overlapping_element_count).toBe(8);\n  expect(decoded.metadata.data_bytes).toBe(38);\n  expect(decoded.limitations).toEqual([\n    \"8 DfuSe element(s) overlap an element earlier in address order within the same alternate setting; each stays a separate entry and no bytes were merged: \" +\n      \"target 0 element 7 (0x08000001-0x08000004) overlaps target 0 element 8 (0x08000000-0x08000003) in alternate setting 0; \" +\n      \"target 0 element 6 (0x08000002-0x08000005) overlaps target 0 element 7 (0x08000001-0x08000004) in alternate setting 0; \" +\n      \"target 0 element 5 (0x08000003-0x08000006) overlaps target 0 element 6 (0x08000002-0x08000005) in alternate setting 0; \" +\n      \"target 0 element 4 (0x08000004-0x08000007) overlaps target 0 element 5 (0x08000003-0x08000006) in alternate setting 0; and 4 more.\",\n  ]);\n  expect(\n    decoded.elements.map((element) => ({\n      target: element.targetIndex,\n      index: element.elementIndex,\n      address: element.address,\n      bytes: [...element.bytes],\n    })),\n  ).toEqual([\n    ...Array.from({ length: 9 }, (_, index) => ({\n      target: 0,\n      index,\n      address: 0x0800_0000 + (8 - index),\n      bytes: [1, 2, 3, 4],\n    })),\n    { target: 0, index: 9, address: 0x0800_0020, bytes: [9] },\n    { target: 1, index: 0, address: 0x0800_0000, bytes: [9] },\n  ]);\n});\n"}
